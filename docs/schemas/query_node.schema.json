        },
        "name": {
          "description": "",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "description": "\"General of Ash's Host of Cairo\".",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ref",
        "name",
        "alive",
        "role",
        "title"
      ],
      "type": "object"
    }
  },
  "$id": "query_node.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.node`: one hierarchy node.",
  "properties": {
    "children": {
      "description": "place only: the places below.",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "type": "array"
    },
    "crowds": {
      "description": "place only: crowds living under it, biggest first.",
      "properties": {
        "items": {
          "description": "This page.",
          "items": {
            "$ref": "#/$defs/Crowd"
          },
          "type": "array"
        },
        "next_cursor": {
          "description": "Pass as `cursor` for the next page; null on the last page.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "description": "Entries in the whole list.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "next_cursor",
        "total"
      ],
      "type": "object"
    },
    "kind": {
      "description": "Which builder `node` is.",
      "enum": [
        "place",
        "crowd",
        "cell",
        "mob"
      ],
      "type": "string"
    },
    "node": {
      "anyOf": [
        {
          "$ref": "#/$defs/Node"
        },
        {
          "$ref": "#/$defs/Crowd"
        },
        {
          "$ref": "#/$defs/Cell"
        },
        {
          "$ref": "#/$defs/Mob"
        }
      ],
      "description": "place: Node; crowd: Crowd; cell: Cell; mob: Mob."
    },
    "people": {
      "description": "crowd, cell, mob: people known there (came from the crowd, members, in the mob).",
      "properties": {
        "items": {
          "description": "This page.",
          "items": {
            "$ref": "#/$defs/Who"
          },
          "type": "array"
        },
        "next_cursor": {
          "description": "Pass as `cursor` for the next page; null on the last page.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "description": "Entries in the whole list.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "next_cursor",
        "total"
      ],
      "type": "object"
    },
    "ref": {
      "$ref": "#/$defs/Ref"
    }
  },
  "required": [
    "kind",
    "ref",
    "node"
  ],
  "title": "game.node",
  "type": "object",
  "x-applies-to": "game.node reply (WebSocket), GET /api/rooms/{code}/query/node",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {
      "cursor": {
        "description": "Page cursor: `next_cursor` from the previous page. Omit for the first page.",
        "minimum": 0,
        "type": [
          "integer",
          "string"
        ]
      },
      "limit": {
        "description": "Page size (default 20, at most 100).",
        "maximum": 100,
        "minimum": 1,
        "type": [
          "integer",
          "string"
        ]
      },
      "ref": {
        "description": "The node.",
        "pattern": "^(pl|cl|ce|mb):\\d+$",
        "type": "string"
      }
    },
    "required": [
      "ref"
    ],
    "type": "object"
  },
  "x-description": "One hierarchy node by ref: a place (planet, region, city, district: its node, child nodes and a page of its crowds), a crowd (`cl:`, not an army), a cell (`ce:`) or a mob (`mb:`), with the people known there.",
  "x-public": true
}
