    },
    "Stance": {
      "description": "What it is doing as a whole.",
      "enum": [
        "calm",
        "restless",
        "rioting",
        "fleeing",
        "worshipping",
        "fighting",
        "marching",
        "holding",
        "besieging",
        "raiding",
        "retreating",
        "rogue"
      ],
      "type": "string"
