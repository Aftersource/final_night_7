    "Node": {
      "description": "The rolled-up state of a place (planet, region, city, city district).",
      "properties": {
        "allegiance": {
          "description": "Size-weighted allegiance per demigod (sparse).",
          "items": {
            "$ref": "#/$defs/Allegiance"
          },
          "type": "array"
        },
        "at": {
          "$ref": "#/$defs/LonLat"
        },
        "base": {
          "description": "Population at setup.",
          "minimum": 0,
          "type": "integer"
        },
        "dead": {
          "description": "Deaths here so far.",
          "minimum": 0,
          "type": "integer"
        },
        "leader": {
          "anyOf": [
            {
              "$ref": "#/$defs/Who"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "mood": {
          "$ref": "#/$defs/Mood"
        },
        "name": {
          "description": "",
          "type": "string"
        },
        "need": {
          "$ref": "#/$defs/Need"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "The place above (null for the planet)."
        },
        "population": {
          "description": "People living here now (crowds, not armies passing through).",
          "minimum": 0,
          "type": "integer"
