  "$id": "query_node.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.node`: one hierarchy node.",
  "properties": {
    "beat": {
      "description": "hex only.",
      "minimum": 0,
      "type": "integer"
    },
    "cell": {
      "description": "hex only: the hex key asked.",
      "type": "string"
    },
    "children": {
      "description": "place only: the places below.",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "type": "array"
    },
    "crowds": {
      "description": "place only: crowds living under it, biggest first.",
      "properties": {
        "items": {
          "description": "This page.",
          "items": {
            "$ref": "#/$defs/Crowd"
          },
          "type": "array"
        },
        "next_cursor": {
          "description": "Pass as `cursor` for the next page; null on the last page.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "description": "Entries in the whole list.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "next_cursor",
        "total"
      ],
      "type": "object"
    },
    "encounters": {
      "description": "Rules 0.8.0: encounter hexes here (hidden ones only as marked).",
      "items": {
        "$ref": "#/$defs/Encounter"
      },
      "type": "array"
    },
    "extrapolated": {
      "description": "Rules 0.8.0.",
      "type": "boolean"
    },
    "kind": {
      "description": "Which builder `node` is (hex: rules 0.8.0, asked with `cell`).",
      "enum": [
        "place",
        "crowd",
        "cell",
        "mob",
        "hex"
      ],
      "type": "string"
    },
    "loot": {
      "description": "Rules 0.8.0: item tokens lying here.",
      "items": {
        "$ref": "#/$defs/LootToken"
      },
      "type": "array"
    },
    "memory_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryEntry"
        },
        {
          "type": "null"
        }
      ]
    },
    "node": {
      "anyOf": [
        {
          "$ref": "#/$defs/Node"
        },
        {
          "$ref": "#/$defs/Crowd"
        },
        {
          "$ref": "#/$defs/Cell"
        },
        {
          "$ref": "#/$defs/Mob"
        },
        {
          "$ref": "#/$defs/HexState"
        }
      ],
      "description": "place: Node; crowd: Crowd; cell: Cell; mob: Mob; hex: HexState."
    },
    "observed_beat": {
      "description": "Rules 0.8.0.",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "people": {
      "description": "crowd, cell, mob: people known there (came from the crowd, members, in the mob).",
      "properties": {
        "items": {
          "description": "This page.",
          "items": {
            "$ref": "#/$defs/Who"
          },
          "type": "array"
        },
        "next_cursor": {
          "description": "Pass as `cursor` for the next page; null on the last page.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "description": "Entries in the whole list.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "next_cursor",
        "total"
      ],
      "type": "object"
    },
    "ref": {
      "$ref": "#/$defs/Ref"
    },
    "roads": {
      "description": "Rules 0.8.0: roads with an end here.",
      "items": {
        "$ref": "#/$defs/Road"
      },
      "type": "array"
    },
    "shrines": {
      "description": "Rules 0.8.0.",
      "items": {
        "$ref": "#/$defs/Shrine"
      },
      "type": "array"
    },
    "time_of_day": {
      "$ref": "#/$defs/TimeOfDay"
    },
    "time_of_day_phase": {
      "$ref": "#/$defs/DayPhase"
    }
  },
  "required": [
    "kind",
    "node"
  ],
  "title": "game.node",
  "type": "object",
  "x-applies-to": "game.node reply (WebSocket), GET /api/rooms/{code}/query/node",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {
      "cell": {
        "description": "Rules 0.8.0: a hex cell key (\"<face>:<level>:<q>:<r>\") instead of `ref`.",
        "type": "string"
      },
      "cursor": {
        "description": "Page cursor: `next_cursor` from the previous page. Omit for the first page.",
        "minimum": 0,
        "type": [
          "integer",
          "string"
        ]
      },
      "limit": {
        "description": "Page size (default 20, at most 100).",
        "maximum": 100,
        "minimum": 1,
        "type": [
          "integer",
          "string"
        ]
      },
      "ref": {
        "description": "The node (or give `cell`).",
        "pattern": "^(pl|cl|ce|mb):\\d+$",
        "type": "string"
      }
    },
    "required": [],
    "type": "object"
  },
  "x-description": "One hierarchy node by ref: a place (planet, region, city, district: its node, child nodes and a page of its crowds), a crowd (`cl:`, not an army), a cell (`ce:`) or a mob (`mb:`), with the people known there. Rules 0.8.0: or a hex (`cell`: a hex cell key) zoomed into: its state now, observed or extrapolated from the DM's memory.",
  "x-public": true
}
