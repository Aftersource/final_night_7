          "description": "Food and goods stock: 1 = normal.",
          "type": "number"
        },
        "worship": {
          "description": "Worship share per god (sparse).",
          "items": {
            "description": "",
            "properties": {
              "god": {
                "description": "",
                "type": "string"
              },
              "god_ref": {
                "$ref": "#/$defs/Ref"
              },
              "value": {
                "description": "0..1",
                "type": "number"
              }
            },
            "required": [
              "god",
              "god_ref",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
