{
  "$defs": {
    "Entropy": {
      "description": "The world's Entropy meter. Every bolt spent anywhere raises it; thresholds make the world wackier (20 weather, 40 physics, 60 riots, 80 godfall); at `max` heat death makes that beat the Final Night.",
      "properties": {
        "delta": {
          "description": "Change during this beat (outcome only).",
          "type": "number"
        },
        "heat_death": {
          "description": "The beat heat death struck, or null.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "key": {
          "description": "The level's key.",
          "enum": [
            "calm",
            "weather",
            "physics",
            "riots",
            "godfall"
          ],
          "type": "string"
        },
        "level": {
          "description": "0..4.",
          "minimum": 0,
          "type": "integer"
        },
        "max": {
          "description": "100: heat death.",
          "type": "number"
        },
        "next_at": {
          "description": "The value of the next threshold (max at the top level).",
          "type": "number"
        },
        "text": {
          "description": "What this level does to the world, one line.",
          "type": "string"
        },
        "value": {
          "description": "0..max.",
          "type": "number"
        }
      },
      "required": [
        "value",
        "max",
        "level",
        "key",
        "text",
        "next_at",
        "heat_death"
      ],
      "type": "object"
    },
    "Hand": {
      "enum": [
        "left",
        "right"
      ],
      "type": "string"
    },
    "ImageObject": {
      "description": "An image the media server attached (only when the server has images on; see docs/MEDIA.md). Fetch `url` once `status` is `ready` (watch GET /media/index for `hash`); `off` = none will come, show a placeholder.",
      "properties": {
        "hash": {
          "description": "Content key (sha256 hex): cache by it forever.",
          "type": "string"
        },
        "kind": {
          "enum": [
            "portrait",
            "item",
            "event",
            "statue",
            "place",
            "army",
            "diorama"
          ],
          "type": "string"
        },
        "prompt": {
          "description": "The full prompt sent to the image model (house style; no engine ids).",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "off"
          ],
          "type": "string"
        },
        "url": {
          "description": "`/media/<hash>.<ext>` once ready, relative to the server's HTTP origin.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hash",
        "kind",
        "status",
        "url",
        "prompt"
      ],
      "type": "object"
    },
    "LonLat": {
      "description": "[longitude, latitude] in degrees (WGS84). Note the order: longitude first.",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "Manifestation": {
      "description": "Rules 0.7.0: one manifestation attempt (made or not).",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ]
        },
        "beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "by": {
          "$ref": "#/$defs/Ref"
        },
        "by_name": {
          "description": "",
          "type": "string"
        },
        "count": {
          "description": "",
          "type": "number"
        },
        "icon": {
          "description": "",
          "enum": [
            "sword",
            "ranged",
            "armor",
            "banner_army",
            "vehicle",
            "beast",
            "structure",
            "relic",
            "artifact",
            "phenomenon",
            "thing"
          ],
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/ImageObject"
        },
        "image_kind": {
          "const": "item"
        },
        "image_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "description": "",
          "enum": [
            "artifact",
            "weapon",
            "armor",
            "relic",
            "structure",
            "army",
            "fleet",
            "creature",
            "phenomenon",
            "other"
          ],
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "description": "",
          "enum": [
            "success",
            "twisted",
            "partial",
            "failed",
            "backfired",
            "refused"
          ],
          "type": "string"
        },
        "public": {
          "description": "",
          "type": "boolean"
        },
        "ref": {
          "description": "`mf:<n>`.",
          "type": "string"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "request": {
          "additionalProperties": true,
          "description": "Your own only: kind, count, magnitude.",
          "type": "object"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hand"
            },
            {
              "type": "null"
            }
          ]
        },
        "tier": {
          "description": "",
          "enum": [
            "trinket",
            "artifact",
            "relic",
            "wonder",
            "legend",
            "myth",
            "titan",
            "apocalypse"
          ],
          "type": "string"
        },
        "unit": {
          "description": "",
          "type": "string"
        },
        "verdict": {
          "additionalProperties": true,
          "description": "Your own only: outcome, tier, odds {success, twist, partial, backfire, terms}, roll, cost {required, bolts, extra, missing, debt}, god, favor, entropy, reasons, flavor.",
          "type": "object"
        }
      },
      "required": [
        "ref",
        "beat",
        "by",
        "by_name",
        "side",
        "kind",
        "icon",
        "tier",
        "count",
        "unit",
        "outcome",
        "item",
        "name",
        "at",
        "region",
        "public",
        "image_prompt",
        "image_kind"
      ],
      "type": "object"
    },
    "Ref": {
      "description": "A pointer to any row of the world: dg demigod, ch character, cl cluster, gr group, gd god, pl place, it item, ag agent, lg ledger row, ce cell, mb mob. Stable for the whole match.",
      "examples": [
        "ch:12"
      ],
      "pattern": "^(dg|ch|cl|gr|gd|pl|it|ag|lg|ce|mb):\\d+$",
      "type": "string"
    },
    "StoryboardShot": {
      "description": "One shot of the final-cut animatic (docs/SHARED_MEDIA_SPEC.md §3.3): fly the globe to `at`, show `image`, caption it, hold `duration_ms`.",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where, [lon, lat]."
        },
        "beat": {
          "description": "The beat it shows (0 for the title).",
          "minimum": 0,
          "type": "integer"
        },
        "camera": {
          "description": "globe: fly the globe to `at`; close: a close-up (eliminations, the champion).",
          "enum": [
            "globe",
            "close"
          ],
          "type": "string"
        },
        "caption": {
          "description": "What to show under it.",
          "type": "string"
        },
        "duration_ms": {
          "description": "How long to hold it.",
          "minimum": 0,
          "type": "integer"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageObject"
            },
            {
              "type": "null"
            }
          ],
          "description": "The event or portrait image object (null when the server has images off)."
        },
        "image_kind": {
          "enum": [
            "event",
            "portrait"
          ],
          "type": "string"
        },
        "image_prompt": {
          "description": "The subject the image is drawn from (a moment's is exactly its moment card's, so the same picture).",
          "type": "string"
        },
        "kind": {
          "description": "title: the final cut's title over the arena; moment: one of the match's biggest public moments; champion: the champion's close-up with the final cut's closing lines.",
          "enum": [
            "title",
            "moment",
            "champion"
          ],
          "type": "string"
        },
        "refs": {
          "description": "Who is in it.",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "region": {
          "description": "Region (planet) or district (city), or the arena for the title.",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "moment: its ledger row."
        },
        "shot": {
          "description": "Index, from 0.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shot",
        "kind",
        "beat",
        "at",
        "region",
        "image_prompt",
        "image_kind",
        "image",
        "caption",
        "duration_ms",
        "camera",
        "row",
        "refs"
      ],
      "type": "object"
    }
  },
  "$id": "match_summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`match.ended.summary`.",
  "properties": {
    "champion_player": {
      "description": "Rules 0.7.0: the surviving player.",
      "type": [
        "string",
        "null"
      ]
    },
    "champion_seat": {
      "description": "The champion's Theatre seat; null when a built-in AI demigod won (then match.ended.winners is []).",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "champions": {
      "description": "The survivor (one entry; if nobody stands, the last to fall).",
      "items": {
        "description": "",
        "properties": {
          "demigod": {
            "$ref": "#/$defs/Ref"
          },
          "health": {
            "description": "Health at the end.",
            "type": "number"
          },
          "name": {
            "description": "",
            "type": "string"
          },
          "player": {
            "description": "Rules 0.7.0: the champion player's name.",
            "type": "string"
          },
          "seat": {
            "description": "Theatre seat; null for the built-in AI's demigods.",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "side": {
            "$ref": "#/$defs/Hand"
          }
        },
        "required": [
          "demigod",
          "name",
          "seat",
          "health"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "entropy": {
      "$ref": "#/$defs/Entropy"
    },
    "final_cut": {
      "description": "The match's story.",
      "properties": {
        "fallback": {
          "description": "True = the captions, not an LLM story.",
          "type": "boolean"
        },
        "story": {
          "description": "Narrator's final cut (<= 250 words), or the beat captions joined by newlines when fallback.",
          "type": "string"
        },
        "title": {
          "description": "",
          "type": "string"
        }
      },
      "required": [
        "title",
        "story",
        "fallback"
      ],
      "type": "object"
    },
    "heat_death": {
      "description": "The beat heat death struck (the Final Night came early), or null.",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "last_caption": {
      "description": "The last beat's caption (narrated one beat late, so it is written at the end of the match, with the champion given to the narrator). Absent when the last beat saw nothing to narrate.",
      "properties": {
        "beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "caption": {
          "description": "",
          "type": "string"
        }
      },
      "required": [
        "beat",
        "caption"
      ],
      "type": "object"
    },
    "manifests": {
      "description": "Rules 0.7.0: every public manifestation of the match.",
      "items": {
        "$ref": "#/$defs/Manifestation"
      },
      "type": "array"
    },
    "piles": {
      "description": "One per demigod, in id order.",
      "items": {
        "description": "Everything one demigod held and summoned, its stats and an image prompt for its statue (the end screen).",
        "properties": {
          "alive": {
            "description": "",
            "type": "boolean"
          },
          "bolts": {
            "description": "Bolts it held at the end.",
            "minimum": 0,
            "type": "integer"
          },
          "demigod": {
            "$ref": "#/$defs/Ref"
          },
          "image_kind": {
            "enum": [
              "statue"
            ],
            "type": "string"
          },
          "items": {
            "description": "Items it or its agents/bodies ever held.",
            "items": {
              "description": "",
              "properties": {
                "count": {
                  "description": "",
                  "type": "number"
                },
                "icon": {
                  "type": "string"
                },
                "image": {
                  "$ref": "#/$defs/ImageObject"
                },
                "image_prompt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "item": {
                  "$ref": "#/$defs/Ref"
                },
                "kind": {
                  "type": "string"
                },
                "name": {
                  "description": "",
                  "type": "string"
                },
                "origin": {
                  "description": "How it came to be: starting kit, summoned, found, echoed (a copy of `origin_ref`) or granted by the god `origin_ref`.",
                  "enum": [
                    "starting",
                    "summoned",
                    "found",
                    "echoed",
                    "granted"
                  ],
                  "type": "string"
                },
                "origin_ref": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Ref"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The source item (`it:<n>`) for echoed, the god (`gd:<n>`) for granted, else null."
                },
                "state": {
                  "type": "string"
                },
                "tier": {
                  "type": "string"
                },
                "unit": {
                  "description": "",
                  "type": "string"
                }
              },
              "required": [
                "item",
                "name",
                "origin",
                "origin_ref"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "name": {
            "description": "",
            "type": "string"
          },
          "seat": {
            "description": "Theatre seat; null for the built-in AI's demigods.",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "slows": {
            "description": "Times it slowed time.",
            "minimum": 0,
            "type": "integer"
          },
          "stats": {
            "description": "",
            "properties": {
              "acts": {
                "description": "Ledger rows it (or its agents/bodies) acted in.",
                "minimum": 0,
                "type": "integer"
              },
              "debt_paid": {
                "description": "Debt collected or settled.",
                "type": "number"
              },
              "memorized_people": {
                "description": "People it memorized.",
                "minimum": 0,
                "type": "integer"
              },
              "rulings": {
                "description": "God rulings it invoked.",
                "minimum": 0,
                "type": "integer"
              },
              "subagents": {
                "description": "Subagents and possessions it spawned.",
                "minimum": 0,
                "type": "integer"
              },
              "words": {
                "description": "Words spoken to its hands.",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "words",
              "acts",
              "debt_paid",
              "rulings",
              "memorized_people",
              "subagents"
            ],
            "type": "object"
          },
          "statue_image": {
            "$ref": "#/$defs/ImageObject",
            "description": "Its statue (images on only)."
          },
          "statue_prompt": {
            "description": "An image-generation prompt for its amiibo-style statue (with its visual sheet).",
            "type": "string"
          },
          "summons": {
            "description": "Items it created.",
            "items": {
              "description": "",
              "properties": {
                "item": {
                  "$ref": "#/$defs/Ref"
                },
                "name": {
                  "description": "",
                  "type": "string"
                }
              },
              "required": [
                "item",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "demigod",
          "name",
          "seat",
          "alive",
          "items",
          "summons",
          "stats",
          "statue_prompt",
          "image_kind",
          "bolts",
          "slows"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "players": {
      "description": "One per player, best first.",
      "items": {
        "additionalProperties": true,
        "description": "Rules 0.7.0 (for fn7-profile): {seat, display_name, demigod, rank, champion, alive, aura, controller, demigods: [{ref, side, name, alive, health, eliminated_beat, cause, cell, visual, rank, items, portrait_prompt, diorama_prompt}]}",
        "type": "object"
      },
      "type": "array"
    },
    "standings": {
      "description": "Every demigod, best first.",
      "items": {
        "description": "One demigod's final place.",
        "properties": {
          "alive": {
            "description": "",
            "type": "boolean"
          },
          "aura": {
            "description": "Rules 0.7.0.",
            "type": "string"
          },
          "cause": {
            "description": "How it fell.",
            "type": [
              "string",
              "null"
            ]
          },
          "demigod": {
            "$ref": "#/$defs/Ref"
          },
          "demigods": {
            "description": "Rules 0.7.0: each of the player's demigods.",
            "items": {
              "additionalProperties": true,
              "description": "{ref, demigod, side, name, alive, health, eliminated_beat, cause, cell, visual}",
              "type": "object"
            },
            "type": "array"
          },
          "eliminated_beat": {
            "description": "",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "description": "",
            "type": "string"
          },
          "player": {
            "description": "Rules 0.7.0: standings are per player; the player's name.",
            "type": "string"
          },
          "rank": {
            "description": "1 = champion.",
            "minimum": 0,
            "type": "integer"
          },
          "score": {
            "description": "Same formula as round.committed scores: 1e6 if alive + followers + 100 x total favor.",
            "type": "number"
          },
          "seat": {
            "description": "Theatre seat; null for the built-in AI's demigods.",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "rank",
          "demigod",
          "name",
          "seat",
          "alive",
          "eliminated_beat",
          "cause",
          "score"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "stats": {
      "description": "Match totals.",
      "properties": {
        "agents": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "armies": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "beats": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "beats_total": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "casts": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "characters": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "eliminations": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "intents": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "ledger_rows": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "llm_calls": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "llm_fallbacks": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "memories": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "memorized": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "mods": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "rulings": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "slows": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "beats",
        "beats_total",
        "ledger_rows",
        "characters",
        "memorized",
        "agents",
        "rulings",
        "intents",
        "memories",
        "llm_calls",
        "llm_fallbacks",
        "eliminations",
        "casts",
        "slows",
        "armies",
        "mods"
      ],
      "type": "object"
    },
    "storyboard": {
      "description": "The final-cut animatic, in play order: the title, the biggest moments as they happened, the champion. Always present since the media release; absent in older recordings.",
      "items": {
        "$ref": "#/$defs/StoryboardShot"
      },
      "type": "array"
    }
  },
  "required": [
    "champions",
    "champion_seat",
    "standings",
    "piles",
    "final_cut",
    "stats",
    "entropy",
    "heat_death"
  ],
  "title": "match.ended summary",
  "type": "object",
  "x-applies-to": "match.ended.summary"
}
