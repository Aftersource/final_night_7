  "title": "game.earth",
  "type": "object",
  "x-applies-to": "game.earth reply (WebSocket), GET /api/rooms/{code}/query/earth",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {
      "base": {
        "description": "true: add `globe` (h, top and fuel of every cell of the globe, about 26,000, in index order).",
        "type": [
          "boolean",
          "string"
        ]
      },
      "bbox": {
        "description": "[west, south, east, north] in degrees (regions level).",
        "type": [
          "array",
          "string"
        ]
      },
      "beat": {
        "description": "A past beat (default: now).",
        "minimum": 0,
        "type": [
          "integer",
          "string"
        ]
      },
      "cell": {
        "description": "A hex cell key (\"<face>:<level>:<q>:<r>\"): the view's centre.",
        "type": "string"
      },
      "format": {
        "description": "Cell encoding (default pack).",
        "enum": [
          "pack",
          "columns",
          "json"
        ],
        "type": "string"
      },
      "grid": {
        "description": "true: add the grid (face, q, r of every cell in index order).",
        "type": [
          "boolean",
          "string"
        ]
      },
      "level": {
        "description": "The zoom level (default regions).",
        "enum": [
          "regions",
          "villages",
          "houses",
          "people"
        ],
        "type": "string"
      },
      "region": {
        "description": "A region (or any place): the view's centre.",
        "pattern": "^pl:\\d+$",
        "type": "string"
      },
      "rings": {
        "description": "Hex rings around the centre (default 3 at regions, at most 12; 6 below, at most 16).",
        "maximum": 16,
        "minimum": 0,
        "type": [
          "integer",
          "string"
        ]
      }
    },
    "required": [],
    "type": "object"
  },
  "x-description": "The Earth simulator (state schema 13): the voxel field for a view. No args: every cell that differs from the base terrain. `cell` (a hex key of any level) or `region` (a `pl:` ref) with `rings`: the board around it; `bbox`: a box of regions cells; `base: true`: adds `globe`, every cell's height and top material now; `grid: true`: adds the grid's cell list. `level` below regions (villages, houses, people) returns hexes derived from the coarse cell under them (a pure function of the field, the seed and the hex). `beat`: the field as it stood at a past beat. Cells come as one packed base64 block (`format: \"columns\"` for a base64 array per column, \"json\" for number arrays). See docs/EARTH_SIM.md.",
  "x-public": true
}
