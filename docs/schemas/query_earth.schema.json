        "id": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "intensity": {
          "description": "power / 16 (a mega of magnitude 8 starts near 8).",
          "type": "number"
        },
        "kind": {
          "description": "",
          "enum": [
            "storm",
            "lightning",
            "flood",
            "wildfire",
            "volcano",
            "earthquake",
            "meteor",
            "raise_land",
            "sink_land",
            "forest",
            "swarm",
            "blizzard",
            "tidal_wave",
            "plate_drift"
          ],
          "type": "string"
        },
        "moves_left": {
          "type": "integer"
        },
        "next_move_in": {
          "type": "integer"
        },
        "origin": {
          "$ref": "#/$defs/LonLat"
        },
        "owner_seat": {
          "description": "The seat that cast it; null = the world's own.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parent": {
          "description": "The phenomenon that set it off.",
          "minimum": 0,
          "type": "integer"
        },
        "power": {
          "type": "integer"
        },
        "radius_cells": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "radius_km": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "ruptured_cells": {
          "type": "integer"
        },
        "state": {
          "description": "A volcano's.",
          "enum": [
            "erupting",
            "dormant"
          ],
          "type": "string"
        },
        "tier": {
          "description": "",
          "enum": [
            "mini",
            "mega",
            "god",
            "world"
          ],
          "type": "string"
        },
        "velocity": {
          "description": "Where it will be a beat from now (glide toward it).",
          "properties": {
            "cells_per_beat": {
              "description": "",
              "type": "number"
            },
            "dir": {
              "description": "Hex direction 0..5.",
              "minimum": 0,
              "type": "integer"
            },
            "to": {
              "$ref": "#/$defs/LonLat"
            },
            "to_cell": {
              "description": "",
              "type": "string"
            }
          },
          "required": [
            "dir",
            "to",
            "to_cell",
            "cells_per_beat"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "at",
        "cell",
        "cell_index",
        "origin",
        "radius_cells",
        "radius_km",
        "power",
        "intensity",
        "age",
        "born",
        "beats_left",
        "owner_seat",
        "cause",
        "tier"
      ],
      "type": "object"
    },
    "EarthScars": {
