{
  "$defs": {
    "EarthCells": {
      "description": "State schema 13: cell columns (docs/EARTH_SIM.md §7). `enc: pack` (the default): `data` is one base64 block, per cell in index order: varint index delta, height byte (0..15), top byte (an index into `tops`), varint layer mask, then one byte per set layer (CLIENT_LAYERS order; `heat` signed). `enc: columns`: `cells` (u16 LE), `h`, `top` and `layers{name}`, one base64 array each. `enc: json`: the same columns as number arrays.",
      "properties": {
        "cells": {
          "description": "Regions-grid cell indices.",
          "type": [
            "string",
            "array"
          ]
        },
        "data": {
          "description": "enc pack: the base64 block.",
          "type": "string"
        },
        "enc": {
          "description": "",
          "enum": [
            "pack",
            "columns",
            "json"
          ],
          "type": "string"
        },
        "h": {
          "description": "Heights 0..15 (8 = sea level).",
          "type": [
            "string",
            "array"
          ]
        },
        "layers": {
          "additionalProperties": {
            "type": [
              "string",
              "array"
            ]
          },
          "description": "A column per non-zero layer.",
          "type": "object"
        },
        "n": {
          "description": "Cells.",
          "minimum": 0,
          "type": "integer"
        },
        "top": {
          "description": "Top material indices (into `tops`).",
          "type": [
            "string",
            "array"
          ]
        }
      },
      "required": [
        "n",
        "enc"
      ],
      "type": "object"
    },
    "EarthEffect": {
      "description": "State schema 20: one thing the earth did (docs/EARTH_SIM.md §13). `cell` is at the thing's level: houses for buildings, people for demigods, persons and shrines, villages for settlements and crowds, regions for forests, roads and armies.",
      "properties": {
        "amount": {
          "description": "Damage (demigod, person); share of vegetation gone as the front crossed (forest); ruin share (building); levels lost / 3 (settlement).",
          "type": "number"
        },
        "cause": {
          "description": "The phenomenon's id (0: none named).",
          "minimum": 0,
          "type": "integer"
        },
        "cell": {
          "description": "Hex key `face:level:q:r`.",
          "type": "string"
        },
        "count": {
          "description": "People.",
          "minimum": 0,
          "type": "integer"
        },
        "level": {
          "description": "",
          "enum": [
            "regions",
            "villages",
            "houses",
            "people"
          ],
          "type": "string"
        },
        "phenomenon": {
          "description": "The cause's kind.",
          "enum": [
            "storm",
            "lightning",
            "flood",
            "wildfire",
            "volcano",
            "earthquake",
            "meteor",
            "raise_land",
            "sink_land",
            "forest",
            "swarm",
            "blizzard",
            "tidal_wave",
            "plate_drift"
          ],
          "type": "string"
        },
        "power": {
          "description": "The cast's magnitude, 1..10.",
          "minimum": 0,
          "type": "integer"
        },
        "seat": {
          "description": "The caster's seat.",
          "minimum": 0,
          "type": "integer"
        },
        "thing": {
          "description": "",
          "properties": {
            "kind": {
              "description": "",
              "enum": [
                "building",
                "forest",
                "crowd",
                "road",
                "shrine",
                "demigod",
                "person",
                "army",
                "settlement"
              ],
              "type": "string"
            },
            "ref": {
              "description": "cl:N (crowd, army), dg:N, ch:N (person), pl:N (settlement; a building's settlement), shrine:ID, pl:A~pl:B (road).",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "to_cell": {
          "description": "Where they went (fled: the shelter; returned: home).",
          "type": "string"
        },
        "what": {
          "description": "",
          "enum": [
            "burned",
            "flooded",
            "destroyed",
            "damaged",
            "fled",
            "died",
            "sheltered",
            "buried",
            "swept",
            "returned"
          ],
          "type": "string"
        }
      },
      "required": [
        "cell",
        "level",
        "thing",
        "what",
        "cause"
      ],
      "type": "object"
    },
    "EarthPhenomenon": {
      "description": "State schema 13: one live phenomenon of the Earth simulator.",
      "properties": {
        "age": {
          "description": "Beats since it began.",
          "minimum": 0,
          "type": "integer"
        },
        "at": {
          "$ref": "#/$defs/LonLat"
