          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "level": {
          "description": "",
          "type": "string"
        },
        "q": {
          "description": "",
          "type": "string"
        },
        "r": {
          "description": "",
          "type": "string"
        }
      },
      "required": [
        "level",
        "hex_size_m",
        "cells",
        "face",
        "q",
        "r"
