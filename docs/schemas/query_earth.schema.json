  "$id": "query_earth.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.earth` (state schema 13): the voxel field for a view (docs/EARTH_SIM.md).",
  "properties": {
    "beat": {
      "description": "The beat shown.",
      "minimum": 0,
      "type": "integer"
    },
    "board": {
      "description": "State schema 13: the client's board: 9 bytes per hex (`fields`) in ring order (ring 0, then each ring as the shared hex formula walks it), base64.",
      "properties": {
        "center": {
          "description": "The centre hex key.",
          "type": "string"
        },
        "changed": {
          "description": "With `since`: the ring positions (u16 LE) whose records are in `data`.",
          "type": "string"
        },
        "coarse": {
          "description": "With `coarse`: the regions cell index under each hex (u16 LE).",
          "type": "string"
        },
        "data": {
          "description": "",
          "type": "string"
        },
        "enc": {
          "const": "b64"
        },
        "fields": {
          "description": "h16 (height in 256ths, 128 = sea level), top, water, lava, ash, fire, snow, heat (signed), crack.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "level": {
          "description": "",
          "type": "string"
        },
        "n": {
          "description": "Records in `data`.",
          "minimum": 0,
          "type": "integer"
        },
        "rings": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "since": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "level",
        "center",
        "rings",
        "n",
        "fields",
        "enc",
        "data"
      ],
      "type": "object"
    },
    "center_cell": {
      "description": "",
      "type": "string"
    },
    "derived": {
      "description": "",
      "type": "boolean"
    },
    "dirty": {
      "description": "",
      "minimum": 0,
      "type": "integer"
    },
    "effects": {
      "description": "State schema 20: what the earth did this beat, thing by thing, worst first, at most `earth_effects_max` (docs/EARTH_SIM.md §13).",
      "items": {
        "$ref": "#/$defs/EarthEffect"
      },
      "type": "array"
    },
    "effects_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "State schema 20: effects per `what`, before the cap.",
      "type": "object"
    },
    "effects_total": {
      "description": "State schema 20: effects before the cap.",
      "minimum": 0,
      "type": "integer"
    },
    "field": {
      "$ref": "#/$defs/EarthCells"
    },
    "from_keyframe": {
      "description": "",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "globe": {
      "description": "`base: true`: every cell's height, top and fuel now, in index order.",
      "properties": {
        "enc": {
          "description": "",
          "type": "string"
        },
        "fuel": {
          "description": "",
          "type": [
            "string",
            "array"
          ]
        },
        "h": {
          "description": "",
          "type": [
            "string",
            "array"
          ]
        },
        "n": {
          "description": "",
          "minimum": 0,
          "type": "integer"
