{
  "$defs": {
    "LibrarySprite": {
      "description": "A picture from the people-and-houses library (docs/MEDIA.md \"Sprites and buildings\"): one per key, generated once and cached forever. The bare plugin sends `status: off` with null `hash` and `url`; the server's media layer fills them (`pending`, then `ready` via GET /media/index; `off` = images off, refused by the budget or failed: draw your placeholder).",
      "properties": {
        "hash": {
          "description": "The media key (null from the bare plugin or with images off).",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "`sprite/<role>/<look>` or `building/<kind>/<look>`: the stable library key.",
          "type": "string"
        },
        "kind": {
          "description": "",
          "enum": [
            "sprite",
            "building"
          ],
          "type": "string"
        },
        "status": {
          "description": "",
          "enum": [
            "pending",
            "ready",
            "off"
          ],
          "type": "string"
        },
        "url": {
          "description": "`/media/<hash>.<ext>` once ready.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "kind",
        "status",
        "url",
        "hash"
      ],
      "type": "object"
    }
  },
  "$id": "query_sprites.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.sprites`: the whole people-and-houses picture library, location-free (48 person sprites + 24 building pictures).",
  "properties": {
    "items": {
      "description": "",
      "items": {
        "description": "One library picture.",
        "properties": {
          "building": {
            "description": "A building's kind (buildings only).",
            "type": "string"
          },
          "key": {
            "description": "The library key.",
            "type": "string"
          },
          "look": {
            "description": "1..3 for people; poor/common/rich for buildings.",
            "type": "string"
          },
          "role": {
            "description": "A person sprite's role (people only).",
            "type": "string"
          },
          "sprite": {
            "$ref": "#/$defs/LibrarySprite"
          }
        },
        "required": [
          "key",
          "look",
          "role",
          "building",
          "sprite"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "description": "",
      "enum": [
        "people",
        "buildings",
        "all"
      ],
      "type": "string"
    },
    "total": {
      "description": "",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "total",
    "items"
  ],
  "title": "game.sprites",
  "type": "object",
  "x-applies-to": "game.sprites reply (WebSocket), GET /api/rooms/{code}/query/sprites",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {
      "kind": {
        "description": "Which part of the library (default all).",
        "enum": [
          "people",
          "buildings",
          "all"
        ],
        "type": "string"
      }
    },
    "required": [],
    "type": "object"
  },
  "x-description": "People and houses: the whole picture library, location-free: every person sprite (16 roles x 3 looks) and building picture (8 kinds x 3 looks) with its `sprite` {key, kind, status, url, hash}, so a client can dress its own people and houses. Read-only.",
  "x-public": true
}
