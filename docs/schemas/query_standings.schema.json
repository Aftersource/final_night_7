{
  "$defs": {
    "Hand": {
      "enum": [
        "left",
        "right"
      ],
      "type": "string"
    },
    "Ref": {
      "description": "A pointer to any row of the world: dg demigod, ch character, cl cluster, gr group, gd god, pl place, it item, ag agent, lg ledger row, ce cell, mb mob. Stable for the whole match.",
      "examples": [
        "ch:12"
      ],
      "pattern": "^(dg|ch|cl|gr|gd|pl|it|ag|lg|ce|mb):\\d+$",
      "type": "string"
    }
  },
  "$id": "query_standings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.standings`: everyone ranked now (alive first, then who fell last, then score; never by health).",
  "properties": {
    "alive": {
      "description": "",
      "minimum": 0,
      "type": "integer"
    },
    "beat": {
      "description": "",
      "minimum": 0,
      "type": "integer"
    },
    "beats_total": {
      "description": "",
      "minimum": 0,
      "type": "integer"
    },
    "over": {
      "description": "The match is over.",
      "type": "boolean"
    },
    "players": {
      "description": "Best first.",
      "items": {
        "description": "Rules 0.7.0: one player ranked (never health).",
        "properties": {
          "alive": {
            "description": "",
            "type": "boolean"
          },
          "aura": {
            "description": "",
            "type": "string"
          },
          "bolts": {
            "description": "",
            "minimum": 0,
            "type": "integer"
          },
          "demigods": {
            "description": "",
            "items": {
              "description": "",
              "properties": {
                "alive": {
                  "description": "",
                  "type": "boolean"
                },
                "cause": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "eliminated_beat": {
                  "description": "",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "name": {
                  "description": "",
                  "type": "string"
                },
                "ref": {
                  "$ref": "#/$defs/Ref"
                },
                "side": {
                  "$ref": "#/$defs/Hand"
                }
              },
              "required": [
                "ref",
                "side",
                "name",
                "alive",
                "eliminated_beat",
                "cause"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "player": {
            "description": "",
            "type": "string"
          },
          "rank": {
            "description": "",
            "minimum": 0,
            "type": "integer"
          },
          "seat": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "rank",
          "seat",
          "player",
          "aura",
          "alive",
          "bolts",
          "demigods"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "players_alive": {
      "description": "Rules 0.7.0.",
      "minimum": 0,
      "type": "integer"
    },
    "standings": {
      "description": "Best first.",
      "items": {
        "allOf": [
          {
            "description": "One demigod's final place.",
            "properties": {
              "alive": {
                "description": "",
                "type": "boolean"
              },
              "aura": {
                "description": "Rules 0.7.0.",
                "type": "string"
              },
              "cause": {
                "description": "How it fell.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "demigod": {
                "$ref": "#/$defs/Ref"
              },
              "demigods": {
                "description": "Rules 0.7.0: each of the player's demigods.",
                "items": {
                  "additionalProperties": true,
                  "description": "{ref, demigod, side, name, alive, health, eliminated_beat, cause, cell, visual}",
                  "type": "object"
                },
                "type": "array"
              },
              "eliminated_beat": {
                "description": "",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "name": {
                "description": "",
                "type": "string"
              },
              "player": {
                "description": "Rules 0.7.0: standings are per player; the player's name.",
                "type": "string"
              },
              "rank": {
                "description": "1 = champion.",
                "minimum": 0,
                "type": "integer"
              },
              "score": {
                "description": "Same formula as round.committed scores: 1e6 if alive + followers + 100 x total favor.",
                "type": "number"
              },
              "seat": {
                "description": "Theatre seat; null for the built-in AI's demigods.",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "rank",
              "demigod",
              "name",
              "seat",
              "alive",
              "eliminated_beat",
              "cause",
              "score"
            ],
            "type": "object"
          },
          {
            "description": "",
            "properties": {
              "bolts": {
                "description": "Bolts held (public).",
                "minimum": 0,
                "type": "integer"
              },
              "connected": {
                "description": "As in the PublicView's demigods: true for AI, null for a human (see room.updated seats).",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "controller": {
                "description": "As in the PublicView's demigods.",
                "enum": [
                  "human",
                  "ai"
                ],
                "type": "string"
              }
            },
            "required": [
              "bolts",
              "controller",
              "connected"
            ],
            "type": "object"
          }
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "beat",
    "beats_total",
    "alive",
    "over",
    "standings"
  ],
  "title": "game.standings",
  "type": "object",
  "x-applies-to": "game.standings reply (WebSocket), GET /api/rooms/{code}/query/standings",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {},
    "required": [],
    "type": "object"
  },
  "x-description": "Every demigod ranked now: alive first, then who fell last, then score.",
  "x-public": true
}
