{
  "$defs": {
    "Arena": {
      "description": "The arena: the whole planet (default) or one real city. Time's clock shrinks the safe radius around `center` linearly from start_radius_km (beat 0) to end_radius_km (the Final Night).",
      "properties": {
        "center": {
          "$ref": "#/$defs/LonLat"
        },
        "city": {
          "description": "The city at `center`: on the planet, where the Final Night converges; else the arena city.",
          "type": "string"
        },
        "end_radius_km": {
          "description": "Safe radius on the Final Night.",
          "type": "number"
        },
        "kind": {
          "description": "planet: regions → cities; city: districts → sites.",
          "enum": [
            "planet",
            "city"
          ],
          "type": "string"
        },
        "name": {
          "description": "\"Earth\" on the planet, else the city's name.",
          "type": "string"
        },
        "radius_km": {
          "description": "Current safe radius around `center`. Bodies outside take 1-5 damage at each beat's Start.",
          "type": "number"
        },
        "start_radius_km": {
          "description": "Safe radius at match start.",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "name",
        "city",
        "center",
        "radius_km",
        "start_radius_km",
        "end_radius_km"
      ],
      "type": "object"
    },
    "Army": {
      "description": "A live army (a cluster raised from a crowd).",
      "properties": {
        "chain": {
          "additionalProperties": true,
          "description": "Its chain of command (general, captains, units, morale, supply, the order as understood; the order's text only for its owner).",
          "type": "object"
        },
        "demigod": {
          "description": "The demigod it marches for.",
          "type": "string"
        },
        "demigod_ref": {
          "$ref": "#/$defs/Ref"
        },
        "dest": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it is headed, or null."
        },
        "general": {
          "anyOf": [
            {
              "description": "",
              "properties": {
                "name": {
                  "description": "",
                  "type": "string"
                },
                "ref": {
                  "$ref": "#/$defs/Ref"
                }
              },
              "required": [
                "ref",
                "name"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its live general."
        },
        "name": {
          "description": "",
          "type": "string"
        },
        "orders": {
          "description": "Seat view only (your armies): its standing orders.",
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/LonLat"
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "region": {
          "description": "Where it is.",
          "type": "string"
        },
        "rogue": {
          "description": "Its general mutinied: it answers to no demigod.",
          "type": "boolean"
        },
        "size": {
          "description": "Head count.",
          "minimum": 0,
          "type": "integer"
        },
        "stance": {
          "$ref": "#/$defs/Stance"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "What it marches on (a place, or a demigod it hunts)."
        }
      },
      "required": [
        "ref",
        "name",
        "demigod",
        "demigod_ref",
        "size",
        "pos",
        "region",
        "dest",
        "target"
      ],
      "type": "object"
    },
    "Charges": {
      "description": "Rules 0.7.0, the 1:5 economy: the player's power charges (public). A MEGA power costs a bolt (and every other player gains bolt_gift bolts, spark_gift sparks); a MINI costs a spark (no gifts). Bolts also pay Time's toll and gods' prices.",
      "properties": {
        "bolts": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "sparks": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bolts",
        "sparks"
      ],
      "type": "object"
    },
    "Entropy": {
      "description": "The world's Entropy meter. Every bolt spent anywhere raises it; thresholds make the world wackier (20 weather, 40 physics, 60 riots, 80 godfall); at `max` heat death makes that beat the Final Night.",
      "properties": {
        "delta": {
          "description": "Change during this beat (outcome only).",
          "type": "number"
        },
        "heat_death": {
          "description": "The beat heat death struck, or null.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "key": {
          "description": "The level's key.",
          "enum": [
            "calm",
            "weather",
            "physics",
            "riots",
            "godfall"
          ],
          "type": "string"
        },
        "level": {
          "description": "0..4.",
          "minimum": 0,
          "type": "integer"
        },
        "max": {
          "description": "100: heat death.",
          "type": "number"
        },
        "next_at": {
          "description": "The value of the next threshold (max at the top level).",
          "type": "number"
        },
        "text": {
          "description": "What this level does to the world, one line.",
          "type": "string"
        },
        "value": {
          "description": "0..max.",
          "type": "number"
        }
      },
      "required": [
        "value",
        "max",
        "level",
        "key",
        "text",
        "next_at",
        "heat_death"
      ],
      "type": "object"
    },
    "Hand": {
      "enum": [
        "left",
        "right"
      ],
      "type": "string"
    },
    "ImageObject": {
      "description": "An image the media server attached (only when the server has images on; see docs/MEDIA.md). Fetch `url` once `status` is `ready` (watch GET /media/index for `hash`); `off` = none will come, show a placeholder.",
      "properties": {
        "hash": {
          "description": "Content key (sha256 hex): cache by it forever.",
          "type": "string"
        },
        "kind": {
          "enum": [
            "portrait",
            "item",
            "event",
            "statue",
            "place",
            "army",
            "diorama"
          ],
          "type": "string"
        },
        "prompt": {
          "description": "The full prompt sent to the image model (house style; no engine ids).",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "off"
          ],
          "type": "string"
        },
        "url": {
          "description": "`/media/<hash>.<ext>` once ready, relative to the server's HTTP origin.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hash",
        "kind",
        "status",
        "url",
        "prompt"
      ],
      "type": "object"
    },
    "Influence": {
      "description": "One demigod's share of one region (district in a city): crowds there weighted by their allegiance, its Following, its armies, its presence. A region's shares sum to at most 1; shares under 0.005 are omitted.",
      "properties": {
        "demigod": {
          "description": "",
          "type": "string"
        },
        "demigod_ref": {
          "$ref": "#/$defs/Ref"
        },
        "region": {
          "description": "",
          "type": "string"
        },
        "region_ref": {
          "$ref": "#/$defs/Ref"
        },
        "share": {
          "description": "0..1.",
          "type": "number"
        }
      },
      "required": [
        "region",
        "region_ref",
        "demigod",
        "demigod_ref",
        "share"
      ],
      "type": "object"
    },
    "Item": {
      "description": "Rules 0.7.0: an item (a manifested thing, or one an older path made).",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ]
        },
        "banner": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "description": "A host's banner.",
              "properties": {
                "colors": {
                  "description": "",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "device": {
                  "description": "",
                  "type": "string"
                },
                "motto": {
                  "description": "",
                  "type": "string"
                }
              },
              "required": [
                "device",
                "colors"
              ],
              "type": "object"
            }
          ]
        },
        "count": {
          "description": "Soldiers, vessels, creatures or copies (rounded; f64 range: 100,000,000 is fine).",
          "type": "number"
        },
        "created_beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "created_by": {},
        "description": {
          "description": "",
          "type": "string"
        },
        "history": {
          "description": "Custody: {beat, state, holder?, by?, row?, count?}.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "holder": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "holder_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "icon": {
          "description": "The client's piece or icon.",
          "enum": [
            "sword",
            "ranged",
            "armor",
            "banner_army",
            "vehicle",
            "beast",
            "structure",
            "relic",
            "artifact",
            "phenomenon",
            "thing"
          ],
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/ImageObject"
        },
        "image_kind": {
          "const": "item"
        },
        "image_prompt": {
          "description": "The item image subject (`image_kind` item).",
          "type": "string"
        },
        "kind": {
          "description": "What it is.",
          "enum": [
            "artifact",
            "weapon",
            "armor",
            "relic",
            "structure",
            "army",
            "fleet",
            "creature",
            "phenomenon",
            "other"
          ],
          "type": "string"
        },
        "manifestation": {
          "description": "`mf:<n>`, the attempt that made it.",
          "type": [
            "string",
            "null"
          ]
        },
        "manifestation_detail": {},
        "name": {
          "description": "",
          "type": "string"
        },
        "origin": {
          "description": "game.item only.",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "rows": {
          "description": "game.item only: the attempt's ledger rows.",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "state": {
          "description": "",
          "enum": [
            "held",
            "deployed",
            "destroyed",
            "transferred",
            "stolen"
          ],
          "type": "string"
        },
        "tier": {
          "description": "Its scale tier.",
          "enum": [
            "trinket",
            "artifact",
            "relic",
            "wonder",
            "legend",
            "myth",
            "titan",
            "apocalypse"
          ],
          "type": "string"
        },
        "unit": {
          "description": "\"soldiers\", \"vessels\", \"creatures\" or \"\" (copies).",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "name",
        "description",
        "kind",
        "icon",
        "tier",
        "count",
        "unit",
        "state",
        "holder",
        "holder_name",
        "created_beat",
        "manifestation",
        "at",
        "banner",
        "image_prompt",
        "image_kind"
      ],
      "type": "object"
    },
    "LonLat": {
      "description": "[longitude, latitude] in degrees (WGS84). Note the order: longitude first.",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "Manifestation": {
      "description": "Rules 0.7.0: one manifestation attempt (made or not).",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ]
        },
        "beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "by": {
          "$ref": "#/$defs/Ref"
        },
        "by_name": {
          "description": "",
          "type": "string"
        },
        "count": {
          "description": "",
          "type": "number"
        },
        "icon": {
          "description": "",
          "enum": [
            "sword",
            "ranged",
            "armor",
            "banner_army",
            "vehicle",
            "beast",
            "structure",
            "relic",
            "artifact",
            "phenomenon",
            "thing"
          ],
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/ImageObject"
        },
        "image_kind": {
          "const": "item"
        },
        "image_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "description": "",
          "enum": [
            "artifact",
            "weapon",
            "armor",
            "relic",
            "structure",
            "army",
            "fleet",
            "creature",
            "phenomenon",
            "other"
          ],
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "description": "",
          "enum": [
            "success",
            "twisted",
            "partial",
            "failed",
            "backfired",
            "refused"
          ],
          "type": "string"
        },
        "public": {
          "description": "",
          "type": "boolean"
        },
        "ref": {
          "description": "`mf:<n>`.",
          "type": "string"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "request": {
          "additionalProperties": true,
          "description": "Your own only: kind, count, magnitude.",
          "type": "object"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hand"
            },
            {
              "type": "null"
            }
          ]
        },
        "tier": {
          "description": "",
          "enum": [
            "trinket",
            "artifact",
            "relic",
            "wonder",
            "legend",
            "myth",
            "titan",
            "apocalypse"
          ],
          "type": "string"
        },
        "unit": {
          "description": "",
          "type": "string"
        },
        "verdict": {
          "additionalProperties": true,
          "description": "Your own only: outcome, tier, odds {success, twist, partial, backfire, terms}, roll, cost {required, bolts, extra, missing, debt}, god, favor, entropy, reasons, flavor.",
          "type": "object"
        }
      },
      "required": [
        "ref",
        "beat",
        "by",
        "by_name",
        "side",
        "kind",
        "icon",
        "tier",
        "count",
        "unit",
        "outcome",
        "item",
        "name",
        "at",
        "region",
        "public",
        "image_prompt",
        "image_kind"
      ],
      "type": "object"
    },
    "Omen": {
      "description": "A god's ruling as a client sees it (public omens and your own invocations).",
      "properties": {
        "at": {
          "description": "Where it was invoked, [lon, lat].",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "god": {
          "description": "The god's display name (\"Time\", \"Nature\", \"Consequence\", \"Death\", \"Chance\", \"Memory\", \"Entropy\").",
          "type": "string"
        },
        "god_ref": {
          "$ref": "#/$defs/Ref",
          "description": "The god's ref (`gd:<n>`; the table is in round.brief.public.gods)."
        },
        "region": {
          "description": "The region (planet) or district (city).",
          "type": [
            "string",
            "null"
          ]
        },
        "speech": {
          "description": "What the god said. Never starts with the god's name (render `god` yourself).",
          "type": "string"
        }
      },
      "required": [
        "god",
        "god_ref",
        "speech",
        "at",
        "region"
      ],
      "type": "object"
    },
    "Player": {
      "description": "Rules 0.7.0: one player (a seat, or a built-in AI) and both of its demigods.",
      "properties": {
        "alive": {
          "description": "Either demigod stands.",
          "type": "boolean"
        },
        "aura": {
          "description": "`#RRGGBB`, shared by both demigods.",
          "type": "string"
        },
        "bolts": {
          "description": "The player's purse of lightning bolts (the mega currency; both demigods share it).",
          "minimum": 0,
          "type": "integer"
        },
        "charges": {
          "$ref": "#/$defs/Charges"
        },
        "connected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "controller": {
          "description": "",
          "enum": [
            "human",
            "ai"
          ],
          "type": "string"
        },
        "demigods": {
          "description": "[left, right].",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "index": {
          "description": "Stable player index (aura order).",
          "minimum": 0,
          "type": "integer"
        },
        "player": {
          "description": "",
          "type": "string"
        },
        "seat": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sparks": {
          "description": "The player's sparks (the mini currency).",
          "minimum": 0,
          "type": "integer"
        },
        "time_bill": {
          "$ref": "#/$defs/TimeBill"
        }
      },
      "required": [
        "index",
        "seat",
        "player",
        "aura",
        "alive",
        "bolts",
        "sparks",
        "charges",
        "demigods",
        "time_bill",
        "controller",
        "connected"
      ],
      "type": "object"
    },
    "Ref": {
      "description": "A pointer to any row of the world: dg demigod, ch character, cl cluster, gr group, gd god, pl place, it item, ag agent, lg ledger row, ce cell, mb mob. Stable for the whole match.",
      "examples": [
        "ch:12"
      ],
      "pattern": "^(dg|ch|cl|gr|gd|pl|it|ag|lg|ce|mb):\\d+$",
      "type": "string"
    },
    "SeatHand": {
      "description": "One hand in the seat view.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Ref",
          "description": "The hand's agent ref (`ag:<n>`)."
        },
        "alive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "demigod": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rules 0.7.0: the demigod this hand is (each hand is one of the player's two demigods; `seat_view.demigods[]`\nhas it in full)."
        },
        "diorama_prompt": {
          "description": "The hand's own diorama prompt (identity only, like `portrait_prompt`). The server adds `diorama_image`.",
          "type": "string"
        },
        "health": {
          "description": "Rules 0.7.0: that demigod's health (a seat sees its own) and whether it stands.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "live": {
          "description": "False once your demigod is eliminated.",
          "type": "boolean"
        },
        "name": {
          "description": "\"<you>'s Left Hand\" / \"<you>'s Right Hand\".",
          "type": "string"
        },
        "portrait_prompt": {
          "description": "The hand's own portrait prompt (it is one of the player's two demigods): identity only, from its name and its\nname-keyed visual sheet, the same in every match. The server adds `portrait_image` beside it.",
          "type": "string"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hand"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rules 0.7.0: `left` or `right`."
        },
        "subagents": {
          "description": "Live subagents and possessions under this hand.",
          "items": {
            "$ref": "#/$defs/SubagentLine"
          },
          "type": "array"
        },
        "visual": {
          "description": "The hand's visual sheet: `{sheet_hash, traits: {build, face, outfit, colors, prop, emblem}}`."
        }
      },
      "required": [
        "agent",
        "name",
        "live",
        "subagents"
      ],
      "type": "object"
    },
    "SlowState": {
      "description": "The open slow-time window as of the last resolve (public: who opened it, never who else is typing). The live window is the Theatre's: `window.opened` / `window.closed` and `match.snapshot.window`.",
      "properties": {
        "by": {
          "description": "The initiator's name.",
          "type": "string"
        },
        "by_ref": {
          "$ref": "#/$defs/Ref"
        },
        "deadline_ms": {
          "description": "When it closes at the latest (epoch ms).",
          "minimum": 0,
          "type": "integer"
        },
        "opened_beat": {
          "description": "The first beat that resolved while it was open.",
          "minimum": 0,
          "type": "integer"
        },
        "opened_ms": {
          "description": "When it opened (epoch ms).",
          "minimum": 0,
          "type": "integer"
        },
        "window_id": {
          "description": "The Theatre's window id (`window.opened.window_id`); submit orders with it.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "by",
        "by_ref",
        "window_id",
        "opened_ms",
        "deadline_ms",
        "opened_beat"
      ],
      "type": "object"
    },
    "Stance": {
      "description": "What it is doing as a whole.",
      "enum": [
        "calm",
        "restless",
        "rioting",
        "fleeing",
        "worshipping",
        "fighting",
        "marching",
        "holding",
        "besieging",
        "raiding",
        "retreating",
        "rogue"
      ],
      "type": "string"
    },
    "SubagentKind": {
      "description": "What kind of agent a subagent line is: a subagent, a possession (steers a body) or a paladin (a god's champion).",
      "enum": [
        "subagent",
        "possession",
        "paladin"
      ],
      "type": "string"
    },
    "SubagentLine": {
      "description": "A live subagent, possession or paladin, in every payload that lists one.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Ref",
          "description": "The agent's ref (`ag:<n>`)."
        },
        "beats_left": {
          "description": "Beats until it expires; null = no budget (possessions last until recalled).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "The person it steers (`ch:<n>`) for possessions and paladins, else null."
        },
        "goal": {
          "description": "Its task.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SubagentKind",
          "description": "\"subagent\", \"possession\" (steers `body`) or \"paladin\" (a god's champion in `body`)."
        },
        "line": {
          "description": "What it said this beat (round.private), else its goal.",
          "type": "string"
        },
        "name": {
          "description": "Display name; a possession reads \"<person> (steered by <you>)\".",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "The agent that spawned it (`ag:<n>`, your hand for subagents and possessions), or null."
        }
      },
      "required": [
        "agent",
        "name",
        "goal",
        "line",
        "beats_left",
        "kind",
        "parent",
        "body"
      ],
      "type": "object"
    },
    "TimeBill": {
      "description": "Rules 0.7.0: Time's bill for a window the player opened now: debt(t) = min(debt_cap, debt_base + debt_per_second × t) plus one bolt.",
      "properties": {
        "bolts": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "can_pay_bolt": {
          "description": "",
          "type": "boolean"
        },
        "debt_base": {
          "description": "",
          "type": "number"
        },
        "debt_cap": {
          "description": "",
          "type": "number"
        },
        "debt_per_10s": {
          "description": "",
          "type": "number"
        },
        "debt_per_second": {
          "description": "",
          "type": "number"
        },
        "instant_order_debt": {
          "description": "An order without a window (doubled when no bolt).",
          "type": "number"
        },
        "recent_slows": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "repeat_factor": {
          "description": "",
          "type": "number"
        }
      },
      "required": [
        "bolts",
        "can_pay_bolt",
        "recent_slows",
        "repeat_factor",
        "debt_base",
        "debt_per_second",
        "debt_per_10s",
        "debt_cap",
        "instant_order_debt"
      ],
      "type": "object"
    },
    "Visual": {
      "description": "A character's visual sheet (docs/SHARED_MEDIA_SPEC.md §3.1): picked from the match seed, the character's id and name; the same at every beat and in every replay. Every image of the character carries these traits.",
      "properties": {
        "sheet_hash": {
          "description": "sha256 (hex) of the sheet version, the character's ref and its traits: key art or caches on it.",
          "type": "string"
        },
        "traits": {
          "description": "",
          "properties": {
            "build": {
              "description": "Body type.",
              "type": "string"
            },
            "colors": {
              "description": "Two signature colors (color words).",
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "emblem": {
              "description": "Their emblem (also on their armies' banners).",
              "type": "string"
            },
            "face": {
              "description": "Face and hair.",
              "type": "string"
            },
            "outfit": {
              "description": "What they wear.",
              "type": "string"
            },
            "prop": {
              "description": "The one thing they carry.",
              "type": "string"
            }
          },
          "required": [
            "build",
            "face",
            "outfit",
            "colors",
            "prop",
            "emblem"
          ],
          "type": "object"
        }
      },
      "required": [
        "sheet_hash",
        "traits"
      ],
      "type": "object"
    },
    "WorldMod": {
      "description": "A persistent world mod (left by a cast's ramifications), applied every beat inside its radius.",
      "properties": {
        "at": {
          "$ref": "#/$defs/LonLat"
        },
        "by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "The caster."
        },
        "description": {
          "description": "",
          "type": "string"
        },
        "expires_beat": {
          "description": "null = lasting.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "",
          "type": "string"
        },
        "power": {
          "description": "The power that left it.",
          "type": [
            "string",
            "null"
          ]
        },
        "radius_km": {
          "description": "",
          "type": "number"
        },
        "region": {
          "description": "",
          "type": "string"
        },
        "region_ref": {
          "$ref": "#/$defs/Ref"
        },
        "since_beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "stacks": {
          "description": "1..5: the same mod again in the same region stacks.",
          "minimum": 0,
          "type": "integer"
        },
        "tags": {
          "description": "",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "at",
        "radius_km",
        "region",
        "region_ref",
        "tags",
        "stacks",
        "since_beat",
        "expires_beat",
        "power",
        "by"
      ],
      "type": "object"
    }
  },
  "$id": "public_view.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`round.committed.public_state` and `match.snapshot.public_state`: the public view after each commit.",
  "properties": {
    "alive": {
      "description": "Demigods still standing.",
      "minimum": 0,
      "type": "integer"
    },
    "arena": {
      "$ref": "#/$defs/Arena"
    },
    "armies": {
      "description": "Every live army.",
      "items": {
        "$ref": "#/$defs/Army"
      },
      "type": "array"
    },
    "beat": {
      "description": "Last beat started.",
      "minimum": 0,
      "type": "integer"
    },
    "beats_total": {
      "description": "The Final Night's beat.",
      "minimum": 0,
      "type": "integer"
    },
    "caption": {
      "description": "The latest caption written (narrated one beat late, so usually the beat before `beat`).",
      "type": "string"
    },
    "caption_beat": {
      "description": "The beat `caption` describes; null before the first caption.",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "demigods": {
      "description": "Every demigod in the match, seats and built-in AI, in id order (dg:0, dg:1, ...). Rules 0.7.0: two per player, the Left hands first (dg:0..n), then the Right (dg:n..2n).",
      "items": {
        "description": "A demigod as everyone sees it. Positions of live demigods are public; health is not.",
        "oneOf": [
          {
            "properties": {
              "alive": {
                "const": true
              }
            },
            "required": [
              "pos",
              "place"
            ]
          },
          {
            "properties": {
              "alive": {
                "const": false
              }
            },
            "required": [
              "eliminated_beat",
              "cause"
            ]
          }
        ],
        "properties": {
          "alive": {
            "type": "boolean"
          },
          "aura": {
            "description": "Rules 0.7.0: its player's aura colour (#RRGGBB).",
            "type": "string"
          },
          "bolts": {
            "description": "Lightning bolts it holds (public).",
            "minimum": 0,
            "type": "integer"
          },
          "cause": {
            "description": "Eliminated only: how it fell.",
            "type": [
              "string",
              "null"
            ]
          },
          "cell": {
            "description": "Alive only: its people-level hex cell (`<face>:people:<q>:<r>`, the client's own indexing; rules 0.7.0).",
            "type": "string"
          },
          "connected": {
            "description": "true for an AI-controlled demigod (always there); null for a human one: the game never sees presence, so read room.updated seats[seat].connected.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "controller": {
            "description": "human: a Theatre seat whose player is human plays it (as the game knows: from match start and mid-match takeovers); ai: a Theatre bot seat or the built-in AI. Flips to human when a joiner takes it over. A human who leaves mid-match stays human here until someone takes the seat over: room.updated seats[].is_bot is the live truth.",
            "enum": [
              "human",
              "ai"
            ],
            "type": "string"
          },
          "debt_open": {
            "type": "number"
          },
          "diorama_image": {
            "$ref": "#/$defs/ImageObject",
            "description": "Its diorama, the table minifig (images on only; kind diorama)."
          },
          "diorama_image_kind": {
            "description": "The kind of diorama_prompt.",
            "enum": [
              "diorama"
            ],
            "type": "string"
          },
          "diorama_prompt": {
            "description": "An image prompt for its diorama: the demigod as a tiny geometric miniature on a hex diorama tile with its signature prop (subject only: its name and visual sheet, identity only, the same in every match).",
            "type": "string"
          },
          "eliminated_beat": {
            "description": "Eliminated only.",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "hand": {
            "$ref": "#/$defs/SeatHand"
          },
          "health": {
            "description": "Your own demigods only (seat_view.demigods[]); never a rival's.",
            "type": "number"
          },
          "image_kind": {
            "description": "The kind of portrait_prompt.",
            "enum": [
              "portrait"
            ],
            "type": "string"
          },
          "items": {
            "description": "Rules 0.7.0: its public item pieces (manifested, tier relic or up, or deployed).",
            "items": {
              "$ref": "#/$defs/Item"
            },
            "type": "array"
          },
          "manifests": {
            "items": {
              "$ref": "#/$defs/Manifestation"
            },
            "type": "array"
          },
          "max_health": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "orders": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "place": {
            "description": "Alive only: the place name it is in.",
            "type": "string"
          },
          "player": {
            "description": "Rules 0.7.0: its player's name.",
            "type": "string"
          },
          "portrait_image": {
            "$ref": "#/$defs/ImageObject",
            "description": "Its portrait (images on only)."
          },
          "portrait_prompt": {
            "description": "An image prompt for its portrait (subject only, with its visual sheet; stable all match).",
            "type": "string"
          },
          "pos": {
            "$ref": "#/$defs/LonLat",
            "description": "Alive only."
          },
          "ref": {
            "$ref": "#/$defs/Ref"
          },
          "region": {
            "description": "Alive only: the region (planet) or district (city) it is in.",
            "type": "string"
          },
          "seat": {
            "description": "The Theatre seat; null for the built-in AI's demigods. A mid-match joiner's new seat takes over a built-in AI demigod, whose seat becomes that seat.",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "sibling": {
            "anyOf": [
              {
                "$ref": "#/$defs/Ref"
              },
              {
                "type": "null"
              }
            ],
            "description": "Rules 0.7.0: its player's other demigod."
          },
          "side": {
            "description": "Rules 0.7.0: which of its player's two hands it is.",
            "enum": [
              "left",
              "right",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "sparks": {
            "description": "Rules 0.7.0: its player's sparks (the mini-power currency; public, like bolts: hoarding is visible).",
            "minimum": 0,
            "type": "integer"
          },
          "visual": {
            "$ref": "#/$defs/Visual",
            "description": "Its visual sheet (stable all match). Always present since the media release; absent in older recordings."
          }
        },
        "required": [
          "ref",
          "name",
          "alive",
          "seat"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "entropy": {
      "$ref": "#/$defs/Entropy"
    },
    "gods": {
      "description": "The gods' health.",
      "items": {
        "description": "",
        "properties": {
          "health": {
            "description": "0..10; high Entropy wounds gods; at 0 Entropy answers its invocations.",
            "type": "number"
          },
          "name": {
            "description": "",
            "type": "string"
          },
          "ref": {
            "$ref": "#/$defs/Ref"
          }
        },
        "required": [
          "ref",
          "name",
          "health"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "influence": {
      "description": "Each demigod's share of each region.",
      "items": {
        "$ref": "#/$defs/Influence"
      },
      "type": "array"
    },
    "mods": {
      "description": "Every live world mod.",
      "items": {
        "$ref": "#/$defs/WorldMod"
      },
      "type": "array"
    },
    "omens": {
      "description": "The last resolved beat's public rulings.",
      "items": {
        "$ref": "#/$defs/Omen"
      },
      "type": "array"
    },
    "players": {
      "description": "Rules 0.7.0: the seat list, one entry per player.",
      "items": {
        "$ref": "#/$defs/Player"
      },
      "type": "array"
    },
    "players_alive": {
      "description": "Rules 0.7.0: players with a demigod standing.",
      "minimum": 0,
      "type": "integer"
    },
    "slow": {
      "anyOf": [
        {
          "$ref": "#/$defs/SlowState"
        },
        {
          "type": "null"
        }
      ]
    },
    "society": {
      "additionalProperties": true,
      "description": "The society's public summary (schema 4). Its shape is not frozen yet (the society build is in progress); read defensively.",
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "beat",
    "beats_total",
    "arena",
    "alive",
    "demigods",
    "omens",
    "caption",
    "caption_beat",
    "entropy",
    "slow",
    "influence",
    "armies",
    "mods",
    "gods"
  ],
  "title": "Final Night 7 public view",
  "type": "object",
  "x-applies-to": "round.committed.public_state, match.snapshot.public_state"
}
