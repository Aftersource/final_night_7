{
  "$defs": {
    "ImageObject": {
      "description": "An image the media server attached (only when the server has images on; see docs/MEDIA.md). Fetch `url` once `status` is `ready` (watch GET /media/index for `hash`); `off` = none will come, show a placeholder.",
      "properties": {
        "hash": {
          "description": "Content key (sha256 hex): cache by it forever.",
          "type": "string"
        },
        "kind": {
          "enum": [
            "portrait",
            "item",
            "event",
            "statue",
            "place",
            "army",
            "diorama"
          ],
          "type": "string"
        },
        "prompt": {
          "description": "The full prompt sent to the image model (house style; no engine ids).",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "off"
          ],
          "type": "string"
        },
        "url": {
          "description": "`/media/<hash>.<ext>` once ready, relative to the server's HTTP origin.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hash",
        "kind",
        "status",
        "url",
        "prompt"
      ],
      "type": "object"
    },
    "Item": {
      "description": "Rules 0.7.0: an item (a manifested thing, or one an older path made).",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ]
        },
        "banner": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "description": "A host's banner.",
              "properties": {
                "colors": {
                  "description": "",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "device": {
                  "description": "",
                  "type": "string"
                },
                "motto": {
                  "description": "",
                  "type": "string"
                }
              },
              "required": [
                "device",
                "colors"
              ],
              "type": "object"
            }
          ]
        },
        "count": {
          "description": "Soldiers, vessels, creatures or copies (rounded; f64 range: 100,000,000 is fine).",
          "type": "number"
        },
        "created_beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "created_by": {},
        "description": {
          "description": "",
          "type": "string"
        },
        "history": {
          "description": "Custody: {beat, state, holder?, by?, row?, count?}.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "holder": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "holder_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "icon": {
          "description": "The client's piece or icon.",
          "enum": [
            "sword",
            "ranged",
            "armor",
            "banner_army",
            "vehicle",
            "beast",
            "structure",
            "relic",
            "artifact",
            "phenomenon",
            "thing"
          ],
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/ImageObject"
        },
        "image_kind": {
          "const": "item"
        },
        "image_prompt": {
          "description": "The item image subject (`image_kind` item).",
          "type": "string"
        },
        "kind": {
          "description": "What it is.",
          "enum": [
            "artifact",
            "weapon",
            "armor",
            "relic",
            "structure",
            "army",
            "fleet",
            "creature",
            "phenomenon",
            "other"
          ],
          "type": "string"
        },
        "manifestation": {
          "description": "`mf:<n>`, the attempt that made it.",
          "type": [
            "string",
            "null"
          ]
        },
        "manifestation_detail": {},
        "name": {
          "description": "",
          "type": "string"
        },
        "origin": {
          "description": "game.item only.",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "rows": {
          "description": "game.item only: the attempt's ledger rows.",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "state": {
          "description": "",
          "enum": [
            "held",
            "deployed",
            "destroyed",
            "transferred",
            "stolen"
          ],
          "type": "string"
        },
        "tier": {
          "description": "Its scale tier.",
          "enum": [
            "trinket",
            "artifact",
            "relic",
            "wonder",
            "legend",
            "myth",
            "titan",
            "apocalypse"
          ],
          "type": "string"
        },
        "unit": {
          "description": "\"soldiers\", \"vessels\", \"creatures\" or \"\" (copies).",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "name",
        "description",
        "kind",
        "icon",
        "tier",
        "count",
        "unit",
        "state",
        "holder",
        "holder_name",
        "created_beat",
        "manifestation",
        "at",
        "banner",
        "image_prompt",
        "image_kind"
      ],
      "type": "object"
    },
    "LonLat": {
      "description": "[longitude, latitude] in degrees (WGS84). Note the order: longitude first.",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "Ref": {
      "description": "A pointer to any row of the world: dg demigod, ch character, cl cluster, gr group, gd god, pl place, it item, ag agent, lg ledger row, ce cell, mb mob. Stable for the whole match.",
      "examples": [
        "ch:12"
      ],
      "pattern": "^(dg|ch|cl|gr|gd|pl|it|ag|lg|ce|mb):\\d+$",
      "type": "string"
    }
  },
  "$id": "query_items.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.items` (rules 0.7.0): a page of items, most recent first: public ones for everyone, your own in full.",
  "properties": {
    "beat": {
      "description": "",
      "minimum": 0,
      "type": "integer"
    },
    "items": {
      "description": "",
      "items": {
        "$ref": "#/$defs/Item"
      },
      "type": "array"
    },
    "next_cursor": {
      "description": "",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "total": {
      "description": "",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "items",
    "next_cursor",
    "total",
    "beat"
  ],
  "title": "game.items",
  "type": "object",
  "x-applies-to": "game.items reply (WebSocket), GET /api/rooms/{code}/query/items",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {
      "cursor": {
        "description": "Page cursor: `next_cursor` from the previous page. Omit for the first page.",
        "minimum": 0,
        "type": [
          "integer",
          "string"
        ]
      },
      "holder": {
        "description": "Only items this demigod holds.",
        "pattern": "^dg:\\d+$",
        "type": "string"
      },
      "limit": {
        "description": "Page size (default 20, at most 100).",
        "maximum": 100,
        "minimum": 1,
        "type": [
          "integer",
          "string"
        ]
      },
      "min_tier": {
        "enum": [
          "trinket",
          "artifact",
          "relic",
          "wonder",
          "legend",
          "myth",
          "titan",
          "apocalypse"
        ],
        "type": "string"
      },
      "state": {
        "enum": [
          "held",
          "deployed",
          "destroyed",
          "transferred",
          "stolen"
        ],
        "type": "string"
      }
    },
    "required": [],
    "type": "object"
  },
  "x-description": "Rules 0.7.0: a page of items, most recent first. Public items (manifested things of tier relic or up, or deployed) for everyone; the asking seat's own items in full. Optional filters: holder (a `dg:` ref), state, min_tier.",
  "x-public": true
}
