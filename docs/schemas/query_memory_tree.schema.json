{
  "$defs": {
    "LonLat": {
      "description": "[longitude, latitude] in degrees (WGS84). Note the order: longitude first.",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "RecallPath": {
      "description": "How one granular fact is recalled: its key, its stored answer, its entry, the roll-ups citing it, the prompts carrying it now.",
      "properties": {
        "fact": {
          "description": "",
          "enum": [
            "d20",
            "encounter",
            "earth",
            "settled",
            "person_memory"
          ],
          "type": "string"
        },
        "highlight": {
          "description": "Tree node ids to light up.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "steps": {
          "description": "",
          "items": {
            "$ref": "#/$defs/RecallStep"
          },
          "type": "array"
        },
        "title": {
          "description": "",
          "type": "string"
        }
      },
      "required": [
        "fact",
        "title",
        "highlight",
        "steps"
      ],
      "type": "object"
    },
