        },
        "query_key": {
          "description": "The question it answers, when it is one the DM may be asked again.",
          "type": "string"
        },
        "row": {
          "$ref": "#/$defs/Ref"
        },
        "text": {
          "description": "The entry's line (an observation, which has none: what was seen).",
          "type": "string"
        }
