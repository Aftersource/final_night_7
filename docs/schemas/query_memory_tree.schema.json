  "$id": "query_memory_tree.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.memory_tree`: the tree of consequence, the DM's place × time memory as the exact tree it is (docs/CLIENT_API.md \"Tree of consequence\"). Read-only, bounded, deterministic.",
  "properties": {
    "as_of": {
      "description": "What `beat` shows: the memory exactly as it stood; the society and the earth now (or omitted) for a past beat.",
      "properties": {
        "beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "earth": {
          "description": "",
          "enum": [
            "exact",
            "omitted"
          ],
          "type": "string"
        },
        "memory": {
          "description": "",
          "enum": [
            "exact"
          ],
          "type": "string"
        },
        "society": {
          "description": "",
          "enum": [
            "exact",
            "now"
          ],
          "type": "string"
        }
      },
      "required": [
        "beat",
        "memory",
        "society",
        "earth"
      ],
      "type": "object"
    },
    "beat": {
      "description": "Now.",
      "minimum": 0,
      "type": "integer"
    },
    "bounds": {
      "description": "What one call read.",
      "properties": {
        "dm_window": {
          "description": "",
          "properties": {
            "complete": {
              "description": "Everything was read.",
              "type": "boolean"
            },
            "entries": {
              "description": "",
              "minimum": 0,
              "type": "integer"
            },
            "from_beat": {
              "description": "",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "to_beat": {
              "description": "",
