            "$ref": "#/$defs/TreeEntry"
          },
          "type": "array"
        },
        "entry": {
          "$ref": "#/$defs/TreeEntry"
        },
        "hedge": {
          "description": "",
          "type": "string"
        },
        "items": {
          "description": "rollups: the roll-ups citing it; prompts: each prompt.",
          "items": {
            "anyOf": [
              {
                "description": "One prompt or reader and whether it carries the fact now.",
                "properties": {
                  "at": {
                    "$ref": "#/$defs/LonLat"
                  },
                  "included": {
                    "description": "",
                    "type": "boolean"
                  },
                  "line": {
                    "description": "The fact's own line in it.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "lines": {
                    "description": "dm_memory: the exact lines (dm::prompt_lines), oldest first.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "of": {
                    "description": "",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "place": {
                    "description": "",
                    "type": "string"
                  },
                  "prompt": {
                    "description": "",
                    "enum": [
                      "dm_memory",
                      "memory_summary",
                      "earth",
                      "recall",
                      "game.person",
                      "fold"
                    ],
                    "type": "string"
                  },
                  "rank": {
                    "description": "recall: its rank among its owner's memories.",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "reader": {
                    "description": "Who reads it.",
                    "type": "string"
                  },
                  "rollup_id": {
                    "description": "",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "why": {
                    "description": "Why it is not there.",
                    "type": "string"
                  },
                  "window_complete": {
                    "description": "recall: the ranking saw the whole store.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "prompt",
                  "reader",
                  "included"
                ],
                "type": "object"
              },
              {
                "description": "A roll-up that cites it (DM), or a society node it counts in (minds).",
                "properties": {
                  "beat": {
                    "description": "",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "cites_this": {
                    "description": "",
                    "type": "boolean"
                  },
                  "counted_as": {
                    "description": "",
                    "type": "string"
                  },
                  "facts": {
                    "description": "",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "how": {
                    "description": "",
                    "type": "string"
                  },
                  "id": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "kind_count": {
                    "description": "",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "name": {
                    "description": "",
                    "type": "string"
                  },
                  "place": {
                    "description": "",
                    "type": "string"
                  },
                  "query_key": {
                    "description": "",
                    "type": "string"
                  },
                  "text": {
                    "description": "",
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "key": {
          "description": "query_key: the question's key.",
          "type": [
            "string",
            "null"
          ]
        },
        "key_hash": {
          "description": "query_key (d20): hash_str(key), the second seed of the die.",
          "type": "string"
        },
        "keys": {
          "description": "query_key (encounter): every key of its chain.",
