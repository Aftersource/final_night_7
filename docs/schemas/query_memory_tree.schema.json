    "TreeFact": {
      "description": "One fact as a node shows it (newest first): a DM memory entry (`store: dm`) or a mind's memory (`store: minds`, kind `mind.<kind>`).",
      "properties": {
        "beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "confidence": {
          "description": "A memory's confidence (1 = true memory; rumors less).",
          "type": "number"
        },
        "id": {
          "description": "The entry's id (`dm.memory[id]`) or the memory's id.",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "description": "`dice.rolled`, `encounter.marked`, `earth.quake`, `memory.rollup`, `place.observed`, `story.scar`, `mind.witnessed` ...",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/Ref"
        },
        "place": {
          "description": "The entry's place key (a hex key, a `pl:` ref or \"world\").",
          "type": "string"
        },
        "public": {
          "description": "false only for a private fact shown to its own seat.",
