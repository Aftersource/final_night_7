            },
            "per_beat": {
              "description": "facts_total per beat of the window.",
              "type": "number"
            },
            "per_million_km2": {
              "description": "facts_total per million km² (null: no area).",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "per_beat",
            "per_million_km2",
            "log10_per_km2",
            "area_m2"
          ],
          "type": "object"
        },
        "earth_line": {
          "description": "The earth line the prompts acting here carry now (null: calm, or a past beat).",
          "type": [
            "string",
            "null"
          ]
        },
        "facts_here": {
          "description": "Facts at the node itself.",
          "minimum": 0,
          "type": "integer"
        },
        "facts_total": {
          "description": "Facts at it or rolled up into it (public and private).",
          "minimum": 0,
          "type": "integer"
        },
        "families": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Facts by family (the kind before its dot: earth, encounter, settlement, dice, mind ...).",
          "type": "object"
        },
        "first_beat": {
          "description": "",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hex_level": {
          "description": "3 km, 30 m, 3 m.",
          "enum": [
            "villages",
            "houses",
            "people"
          ],
          "type": "string"
        },
        "id": {
          "description": "The node: \"world\", a `pl:` ref (region, settlement, city district), `open:pl:N` (a region's open country), a hex key, `cl:`, `ce:`, `ch:` or `dg:`.",
          "type": "string"
        },
        "key": {
          "description": "Its memory place key.",
          "type": "string"
        },
        "kind": {
          "description": "",
          "enum": [
            "world",
            "region",
            "settlement",
            "open",
            "hex",
            "district",
            "crowd",
            "cell",
            "person",
            "demigod"
          ],
          "type": "string"
        },
        "kinds": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Facts by kind.",
          "type": "object"
        },
        "last_beat": {
          "description": "The newest fact's beat (glow = recency).",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "level": {
          "description": "The tier (see `levels`).",
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "",
          "type": "string"
        },
        "observed_beat": {
          "description": "A hex: when the DM last recorded it (`place.observed`), null: never.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "on_path": {
          "description": "On the path to the focus (expanded).",
          "type": "boolean"
        },
        "private_facts": {
          "description": "Facts that are not public: counted, never shown (except to their own seat).",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ]
        },
        "rolled_up_from": {
          "description": "Busiest first (only on the path).",
          "items": {
            "description": "A child whose facts rolled up here.",
