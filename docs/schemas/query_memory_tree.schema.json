          },
          "type": "array"
        },
        "asked_again": {
          "description": "",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ],
          "description": ""
        },
        "beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "cell": {
          "description": "",
          "type": [
            "string",
            "null"
          ]
        },
        "cells": {
          "description": "",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence": {
          "description": "",
          "type": "number"
        },
        "derivation": {
          "description": "",
          "type": "string"
        },
        "entries": {
