      "required": [
        "beat",
        "kind",
        "text",
        "public"
      ],
      "type": "object"
    },
    "TreeNode": {
      "description": "One node of the tree of consequence. Draw levels as tiers, size by facts_total, glow by last_beat, edges as roll-ups.",
      "properties": {
        "alive": {
          "description": "",
          "type": "boolean"
        },
        "cell_kind": {
          "description": "gang, squad, congregation, crew, militia.",
