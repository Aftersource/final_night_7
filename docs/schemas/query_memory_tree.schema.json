          ]
        },
        "who": {
          "description": "",
          "type": [
            "string",
            "null"
          ]
        },
        "who_name": {
          "description": "",
          "type": [
            "string",
            "null"
          ]
        },
        "why": {
          "description": "",
          "type": "string"
        }
      },
      "required": [
        "step"
      ],
      "type": "object"
    },
    "Ref": {
      "description": "A pointer to any row of the world: dg demigod, ch character, cl cluster, gr group, gd god, pl place, it item, ag agent, lg ledger row, ce cell, mb mob. Stable for the whole match.",
      "examples": [
        "ch:12"
      ],
      "pattern": "^(dg|ch|cl|gr|gd|pl|it|ag|lg|ce|mb):\\d+$",
      "type": "string"
    },
    "Role": {
      "description": "A person's part in the society.",
      "enum": [
        "commoner",
        "notable",
        "ringleader",
        "general",
        "captain",
        "soldier",
        "hero",
        "coward",
        "witness",
        "prophet",
        "paladin",
        "deserter",
        "avenger"
      ],
      "type": "string"
    },
    "TreeEntry": {
      "description": "A DM memory entry in full (as `game.memory` gives it, without `data`), or a hidden one as {id, beat, kind, public: false, hidden: true}.",
      "properties": {
        "beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "hidden": {
          "description": "A private entry, counted only.",
          "type": "boolean"
        },
        "id": {
          "description": "",
          "minimum": 0,
