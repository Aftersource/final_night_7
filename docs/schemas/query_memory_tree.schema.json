            "type": [
              "string",
              "null"
            ]
          },
          "type": "array"
        },
        "kind": {
          "description": "",
          "type": "string"
        },
        "memory": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "modifier": {
          "description": "",
          "type": [
            "integer",
            "null"
          ]
        },
        "owner": {
