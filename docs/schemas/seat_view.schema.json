{
  "$defs": {
    "Army": {
      "description": "A live army (a cluster raised from a crowd).",
      "properties": {
        "chain": {
          "additionalProperties": true,
          "description": "Its chain of command (general, captains, units, morale, supply, the order as understood; the order's text only for its owner).",
          "type": "object"
        },
        "demigod": {
          "description": "The demigod it marches for.",
          "type": "string"
        },
        "demigod_ref": {
          "$ref": "#/$defs/Ref"
        },
        "dest": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it is headed, or null."
        },
        "general": {
          "anyOf": [
            {
              "description": "",
              "properties": {
                "name": {
                  "description": "",
                  "type": "string"
                },
                "ref": {
                  "$ref": "#/$defs/Ref"
                }
              },
              "required": [
                "ref",
                "name"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its live general."
        },
        "name": {
          "description": "",
          "type": "string"
        },
        "orders": {
          "description": "Seat view only (your armies): its standing orders.",
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/LonLat"
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "region": {
          "description": "Where it is.",
          "type": "string"
        },
        "rogue": {
          "description": "Its general mutinied: it answers to no demigod.",
          "type": "boolean"
        },
        "size": {
          "description": "Head count.",
          "minimum": 0,
          "type": "integer"
        },
        "stance": {
          "$ref": "#/$defs/Stance"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "What it marches on (a place, or a demigod it hunts)."
        }
      },
      "required": [
        "ref",
        "name",
        "demigod",
        "demigod_ref",
        "size",
        "pos",
        "region",
        "dest",
        "target"
      ],
      "type": "object"
    },
    "Charges": {
      "description": "Rules 0.7.0, the 1:5 economy: the player's power charges (public). A MEGA power costs a bolt (and every other player gains bolt_gift bolts, spark_gift sparks); a MINI costs a spark (no gifts). Bolts also pay Time's toll and gods' prices.",
      "properties": {
        "bolts": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "sparks": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bolts",
        "sparks"
      ],
      "type": "object"
    },
    "DebtLine": {
      "description": "One open debt you owe.",
      "properties": {
        "amount": {
          "description": "Damage points (0-10 scale) collected as an accident when it falls due.",
          "type": "number"
        },
        "due_beat": {
          "description": "Beat it falls due (everything falls due on the Final Night).",
          "minimum": 0,
          "type": "integer"
        },
        "owed_by": {
          "$ref": "#/$defs/Ref",
          "description": "Rules 0.7.0: which of your two demigods owes it (the acting body)."
        },
        "owed_to": {
          "description": "The god's display name (usually Consequence; a god's price is owed to that god).",
          "type": "string"
        },
        "owed_to_ref": {
          "$ref": "#/$defs/Ref",
          "description": "That god's ref (`gd:<n>`)."
        },
        "row": {
          "$ref": "#/$defs/Ref",
          "description": "The ledger row that opened the debt (`lg:<n>`)."
        },
        "status": {
          "$ref": "#/$defs/DebtStatus"
        }
      },
      "required": [
        "row",
        "owed_to",
        "owed_to_ref",
        "amount",
        "due_beat",
        "status"
      ],
      "type": "object"
    },
    "DebtStatus": {
      "oneOf": [
        {
          "enum": [
            "open",
            "collected"
          ],
          "type": "string"
        },
        {
          "const": "delayed",
          "description": "Pushed back by Time; `due_beat` moved and `amount` grew.",
          "type": "string"
        },
        {
          "const": "settled",
          "description": "Settled on the Final Night.",
          "type": "string"
        }
      ]
    },
    "Entity": {
      "description": "One thing a seat can see (`world::entity_json`): a ref, its display name and kind, plus a few kind-specific fields. Rivals' health is never included.",
      "properties": {
        "action": {
          "description": "Mobs only: what it is doing (gathering, rioting, looting, attacking, marching, dispersed).",
          "type": "string"
        },
        "alive": {
          "description": "Characters only.",
          "type": "boolean"
        },
        "army_of": {
          "$ref": "#/$defs/Ref",
          "description": "Clusters that are armies only: the demigod (`dg:<n>`) it marches for."
        },
        "cell_kind": {
          "description": "Cells only: gang, squad, congregation, crew or militia.",
          "type": "string"
        },
        "kind": {
          "description": "Matches the ref prefix (dg, ch, cl, gr, gd, pl, it, ag, lg, ce, mb).",
          "enum": [
            "demigod",
            "character",
            "cluster",
            "group",
            "god",
            "place",
            "item",
            "agent",
            "ledger",
            "cell",
            "mob"
          ],
          "type": "string"
        },
        "leader": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cells only."
        },
        "mood": {
          "description": "Clusters only: the dominant mood.",
          "enum": [
            "calm",
            "angry",
            "afraid",
            "hopeful",
            "devoted"
          ],
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/LonLat",
          "description": "Where it is, when it has a position (absent for groups, gods, agents)."
        },
        "rank": {
          "$ref": "#/$defs/Rank",
          "description": "Characters with a society sheet only."
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "ringleader": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mobs only."
        },
        "role": {
          "$ref": "#/$defs/Role",
          "description": "Characters with a society sheet only."
        },
        "size": {
          "description": "Clusters only: approximate head count.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ref",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "FavorLine": {
      "description": "A god's favor toward one demigod.",
      "properties": {
        "favor": {
          "description": "That god's favor toward you (about -10..10; it shifts its rulings).",
          "format": "float",
          "type": "number"
        },
        "god": {
          "description": "The god's display name.",
          "type": "string"
        },
        "god_ref": {
          "$ref": "#/$defs/Ref",
          "description": "The god's ref (`gd:<n>`)."
        }
      },
      "required": [
        "god",
        "god_ref",
        "favor"
      ],
      "type": "object"
    },
    "Hand": {
      "enum": [
        "left",
        "right"
      ],
      "type": "string"
    },
    "ImageObject": {
      "description": "An image the media server attached (only when the server has images on; see docs/MEDIA.md). Fetch `url` once `status` is `ready` (watch GET /media/index for `hash`); `off` = none will come, show a placeholder.",
      "properties": {
        "hash": {
          "description": "Content key (sha256 hex): cache by it forever.",
          "type": "string"
        },
        "kind": {
          "enum": [
            "portrait",
            "item",
            "event",
            "statue",
            "place",
            "army",
            "diorama"
          ],
          "type": "string"
        },
        "prompt": {
          "description": "The full prompt sent to the image model (house style; no engine ids).",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "off"
          ],
          "type": "string"
        },
        "url": {
          "description": "`/media/<hash>.<ext>` once ready, relative to the server's HTTP origin.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hash",
        "kind",
        "status",
        "url",
        "prompt"
      ],
      "type": "object"
    },
    "Item": {
      "description": "Rules 0.7.0: an item (a manifested thing, or one an older path made).",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ]
        },
        "banner": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "description": "A host's banner.",
              "properties": {
                "colors": {
                  "description": "",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "device": {
                  "description": "",
                  "type": "string"
                },
                "motto": {
                  "description": "",
                  "type": "string"
                }
              },
              "required": [
                "device",
                "colors"
              ],
              "type": "object"
            }
          ]
        },
        "count": {
          "description": "Soldiers, vessels, creatures or copies (rounded; f64 range: 100,000,000 is fine).",
          "type": "number"
        },
        "created_beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "created_by": {},
        "description": {
          "description": "",
          "type": "string"
        },
        "history": {
          "description": "Custody: {beat, state, holder?, by?, row?, count?}.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "holder": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "holder_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "icon": {
          "description": "The client's piece or icon.",
          "enum": [
            "sword",
            "ranged",
            "armor",
            "banner_army",
            "vehicle",
            "beast",
            "structure",
            "relic",
            "artifact",
            "phenomenon",
            "thing"
          ],
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/ImageObject"
        },
        "image_kind": {
          "const": "item"
        },
        "image_prompt": {
          "description": "The item image subject (`image_kind` item).",
          "type": "string"
        },
        "kind": {
          "description": "What it is.",
          "enum": [
            "artifact",
            "weapon",
            "armor",
            "relic",
            "structure",
            "army",
            "fleet",
            "creature",
            "phenomenon",
            "other"
          ],
          "type": "string"
        },
        "manifestation": {
          "description": "`mf:<n>`, the attempt that made it.",
          "type": [
            "string",
            "null"
          ]
        },
        "manifestation_detail": {},
        "name": {
          "description": "",
          "type": "string"
        },
        "origin": {
          "description": "game.item only.",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "rows": {
          "description": "game.item only: the attempt's ledger rows.",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "state": {
          "description": "",
          "enum": [
            "held",
            "deployed",
            "destroyed",
            "transferred",
            "stolen"
          ],
          "type": "string"
        },
        "tier": {
          "description": "Its scale tier.",
          "enum": [
            "trinket",
            "artifact",
            "relic",
            "wonder",
            "legend",
            "myth",
            "titan",
            "apocalypse"
          ],
          "type": "string"
        },
        "unit": {
          "description": "\"soldiers\", \"vessels\", \"creatures\" or \"\" (copies).",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "name",
        "description",
        "kind",
        "icon",
        "tier",
        "count",
        "unit",
        "state",
        "holder",
        "holder_name",
        "created_beat",
        "manifestation",
        "at",
        "banner",
        "image_prompt",
        "image_kind"
      ],
      "type": "object"
    },
    "Level": {
      "description": "A level of the hierarchy.",
      "enum": [
        "planet",
        "region",
        "city",
        "district",
        "crowd",
        "cell",
        "person"
      ],
      "type": "string"
    },
    "LonLat": {
      "description": "[longitude, latitude] in degrees (WGS84). Note the order: longitude first.",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "NewsLine": {
      "properties": {
        "at": {
          "description": "Where it happened, [lon, lat] (null only for bookkeeping with no place).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "how": {
          "description": "How you know: \"you did it\", \"it happened to you\", \"you saw it\", \"you were told\", \"your followers heard\" or \"rumor\".",
          "type": "string"
        },
        "refs": {
          "description": "The actor, then the targets (refs to link in the UI), each at most once.",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "region": {
          "description": "The region (planet) or district (city) it happened in.",
          "type": [
            "string",
            "null"
          ]
        },
        "row": {
          "$ref": "#/$defs/Ref",
          "description": "The ledger row's ref (`lg:<n>`). Never repeated within one payload."
        },
        "text": {
          "description": "The act, in prose.",
          "type": "string"
        }
      },
      "required": [
        "row",
        "text",
        "refs",
        "how",
        "at",
        "region"
      ],
      "type": "object"
    },
    "Rank": {
      "description": "Where a person stands.",
      "properties": {
        "level": {
          "$ref": "#/$defs/Level"
        },
        "of": {
          "$ref": "#/$defs/Ref",
          "description": "The node or unit they hold rank in."
        },
        "title": {
          "description": "",
          "type": "string"
        }
      },
      "required": [
        "level",
        "title"
      ],
      "type": "object"
    },
    "Ref": {
      "description": "A pointer to any row of the world: dg demigod, ch character, cl cluster, gr group, gd god, pl place, it item, ag agent, lg ledger row, ce cell, mb mob. Stable for the whole match.",
      "examples": [
        "ch:12"
      ],
      "pattern": "^(dg|ch|cl|gr|gd|pl|it|ag|lg|ce|mb):\\d+$",
      "type": "string"
    },
    "Role": {
      "description": "A person's part in the society.",
      "enum": [
        "commoner",
        "notable",
        "ringleader",
        "general",
        "captain",
        "soldier",
        "hero",
        "coward",
        "witness",
        "prophet",
        "paladin",
        "deserter",
        "avenger"
      ],
      "type": "string"
    },
    "SeatHand": {
      "description": "One hand in the seat view.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Ref",
          "description": "The hand's agent ref (`ag:<n>`)."
        },
        "alive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "demigod": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rules 0.7.0: the demigod this hand is (each hand is one of the player's two demigods; `seat_view.demigods[]`\nhas it in full)."
        },
        "diorama_prompt": {
          "description": "The hand's own diorama prompt (identity only, like `portrait_prompt`). The server adds `diorama_image`.",
          "type": "string"
        },
        "health": {
          "description": "Rules 0.7.0: that demigod's health (a seat sees its own) and whether it stands.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "live": {
          "description": "False once your demigod is eliminated.",
          "type": "boolean"
        },
        "name": {
          "description": "\"<you>'s Left Hand\" / \"<you>'s Right Hand\".",
          "type": "string"
        },
        "portrait_prompt": {
          "description": "The hand's own portrait prompt (it is one of the player's two demigods): identity only, from its name and its\nname-keyed visual sheet, the same in every match. The server adds `portrait_image` beside it.",
          "type": "string"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hand"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rules 0.7.0: `left` or `right`."
        },
        "subagents": {
          "description": "Live subagents and possessions under this hand.",
          "items": {
            "$ref": "#/$defs/SubagentLine"
          },
          "type": "array"
        },
        "visual": {
          "description": "The hand's visual sheet: `{sheet_hash, traits: {build, face, outfit, colors, prop, emblem}}`."
        }
      },
      "required": [
        "agent",
        "name",
        "live",
        "subagents"
      ],
      "type": "object"
    },
    "Stance": {
      "description": "What it is doing as a whole.",
      "enum": [
        "calm",
        "restless",
        "rioting",
        "fleeing",
        "worshipping",
        "fighting",
        "marching",
        "holding",
        "besieging",
        "raiding",
        "retreating",
        "rogue"
      ],
      "type": "string"
    },
    "SubagentKind": {
      "description": "What kind of agent a subagent line is: a subagent, a possession (steers a body) or a paladin (a god's champion).",
      "enum": [
        "subagent",
        "possession",
        "paladin"
      ],
      "type": "string"
    },
    "SubagentLine": {
      "description": "A live subagent, possession or paladin, in every payload that lists one.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Ref",
          "description": "The agent's ref (`ag:<n>`)."
        },
        "beats_left": {
          "description": "Beats until it expires; null = no budget (possessions last until recalled).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "The person it steers (`ch:<n>`) for possessions and paladins, else null."
        },
        "goal": {
          "description": "Its task.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SubagentKind",
          "description": "\"subagent\", \"possession\" (steers `body`) or \"paladin\" (a god's champion in `body`)."
        },
        "line": {
          "description": "What it said this beat (round.private), else its goal.",
          "type": "string"
        },
        "name": {
          "description": "Display name; a possession reads \"<person> (steered by <you>)\".",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "The agent that spawned it (`ag:<n>`, your hand for subagents and possessions), or null."
        }
      },
      "required": [
        "agent",
        "name",
        "goal",
        "line",
        "beats_left",
        "kind",
        "parent",
        "body"
      ],
      "type": "object"
    },
    "TimeBill": {
      "description": "Rules 0.7.0: Time's bill for a window the player opened now: debt(t) = min(debt_cap, debt_base + debt_per_second × t) plus one bolt.",
      "properties": {
        "bolts": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "can_pay_bolt": {
          "description": "",
          "type": "boolean"
        },
        "debt_base": {
          "description": "",
          "type": "number"
        },
        "debt_cap": {
          "description": "",
          "type": "number"
        },
        "debt_per_10s": {
          "description": "",
          "type": "number"
        },
        "debt_per_second": {
          "description": "",
          "type": "number"
        },
        "instant_order_debt": {
          "description": "An order without a window (doubled when no bolt).",
          "type": "number"
        },
        "recent_slows": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "repeat_factor": {
          "description": "",
          "type": "number"
        }
      },
      "required": [
        "bolts",
        "can_pay_bolt",
        "recent_slows",
        "repeat_factor",
        "debt_base",
        "debt_per_second",
        "debt_per_10s",
        "debt_cap",
        "instant_order_debt"
      ],
      "type": "object"
    },
    "YouLine": {
      "properties": {
        "bolts": {
          "description": "Lightning bolts you hold (the god-energy unit: casts and god invocations cost them).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "debt_open": {
          "description": "Sum of your open debts (damage points).",
          "format": "float",
          "type": "number"
        },
        "echo_charges": {
          "description": "Charges left for the echo (duplicate an item) base power.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "favor": {
          "description": "Every god's favor toward you, in god order (gd:0 .. gd:6).",
          "items": {
            "$ref": "#/$defs/FavorLine"
          },
          "type": "array"
        },
        "followers": {
