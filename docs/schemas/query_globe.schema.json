{
  "$defs": {
    "Arena": {
      "description": "The arena: the whole planet (default) or one real city. Time's clock shrinks the safe radius around `center` linearly from start_radius_km (beat 0) to end_radius_km (the Final Night).",
      "properties": {
        "center": {
          "$ref": "#/$defs/LonLat"
        },
        "city": {
          "description": "The city at `center`: on the planet, where the Final Night converges; else the arena city.",
          "type": "string"
        },
        "end_radius_km": {
          "description": "Safe radius on the Final Night.",
          "type": "number"
        },
        "kind": {
          "description": "planet: regions → cities; city: districts → sites.",
          "enum": [
            "planet",
            "city"
          ],
          "type": "string"
        },
        "name": {
          "description": "\"Earth\" on the planet, else the city's name.",
          "type": "string"
        },
        "radius_km": {
          "description": "Current safe radius around `center`. Bodies outside take 1-5 damage at each beat's Start.",
          "type": "number"
        },
        "start_radius_km": {
          "description": "Safe radius at match start.",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "name",
        "city",
        "center",
        "radius_km",
        "start_radius_km",
        "end_radius_km"
      ],
      "type": "object"
    },
    "ArmyMarker": {
      "description": "An army as everyone sees it (no orders, no chain of command).",
      "properties": {
        "demigod": {
          "description": "The demigod it marches for.",
          "type": [
            "string",
            "null"
          ]
        },
        "demigod_ref": {
          "$ref": "#/$defs/Ref"
        },
        "dest": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it is headed."
        },
        "morale": {
          "description": "0..1.",
          "type": "number"
        },
        "name": {
          "description": "",
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/LonLat"
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "region": {
          "description": "Where it is.",
          "type": "string"
        },
        "rogue": {
          "description": "Its general mutinied: it answers to no demigod.",
          "type": "boolean"
        },
        "size": {
          "description": "Head count.",
          "minimum": 0,
          "type": "integer"
        },
        "stance": {
          "$ref": "#/$defs/Stance"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "What it marches on."
        }
      },
      "required": [
        "ref",
        "name",
        "demigod",
        "demigod_ref",
        "rogue",
        "size",
        "pos",
        "region",
        "dest",
        "target",
        "stance",
        "morale"
      ],
      "type": "object"
    },
    "Entropy": {
      "description": "The world's Entropy meter. Every bolt spent anywhere raises it; thresholds make the world wackier (20 weather, 40 physics, 60 riots, 80 godfall); at `max` heat death makes that beat the Final Night.",
      "properties": {
        "delta": {
          "description": "Change during this beat (outcome only).",
          "type": "number"
        },
        "heat_death": {
          "description": "The beat heat death struck, or null.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "key": {
          "description": "The level's key.",
          "enum": [
            "calm",
            "weather",
            "physics",
            "riots",
            "godfall"
          ],
          "type": "string"
        },
        "level": {
          "description": "0..4.",
          "minimum": 0,
          "type": "integer"
        },
        "max": {
          "description": "100: heat death.",
          "type": "number"
        },
        "next_at": {
          "description": "The value of the next threshold (max at the top level).",
          "type": "number"
        },
        "text": {
          "description": "What this level does to the world, one line.",
          "type": "string"
        },
        "value": {
          "description": "0..max.",
          "type": "number"
        }
      },
      "required": [
        "value",
        "max",
        "level",
        "key",
        "text",
        "next_at",
        "heat_death"
      ],
      "type": "object"
    },
    "EventPage": {
      "description": "A page of public events in ledger order.",
      "properties": {
        "head": {
          "description": "Ledger rows so far.",
          "minimum": 0,
          "type": "integer"
        },
        "items": {
          "description": "Oldest first.",
          "items": {
            "$ref": "#/$defs/QueryEvent"
          },
          "type": "array"
        },
        "more": {
          "description": "More rows to scan right now: ask again with `since: next`.",
          "type": "boolean"
        },
        "next": {
          "description": "The ledger row to ask from next time (`since`); poll with it.",
          "minimum": 0,
          "type": "integer"
        },
        "since": {
          "description": "The `since` asked (null: the latest events).",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "since",
        "next",
        "more",
        "head"
      ],
      "type": "object"
    },
    "ImageObject": {
      "description": "An image the media server attached (only when the server has images on; see docs/MEDIA.md). Fetch `url` once `status` is `ready` (watch GET /media/index for `hash`); `off` = none will come, show a placeholder.",
      "properties": {
        "hash": {
          "description": "Content key (sha256 hex): cache by it forever.",
          "type": "string"
        },
        "kind": {
          "enum": [
            "portrait",
            "item",
            "event",
            "statue",
            "place",
            "army",
            "diorama"
          ],
          "type": "string"
        },
        "prompt": {
          "description": "The full prompt sent to the image model (house style; no engine ids).",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "off"
          ],
          "type": "string"
        },
        "url": {
          "description": "`/media/<hash>.<ext>` once ready, relative to the server's HTTP origin.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hash",
        "kind",
        "status",
        "url",
        "prompt"
      ],
      "type": "object"
    },
    "Influence": {
      "description": "One demigod's share of one region (district in a city): crowds there weighted by their allegiance, its Following, its armies, its presence. A region's shares sum to at most 1; shares under 0.005 are omitted.",
      "properties": {
        "demigod": {
          "description": "",
          "type": "string"
        },
        "demigod_ref": {
          "$ref": "#/$defs/Ref"
        },
        "region": {
          "description": "",
          "type": "string"
        },
        "region_ref": {
          "$ref": "#/$defs/Ref"
        },
        "share": {
          "description": "0..1.",
          "type": "number"
        }
      },
      "required": [
        "region",
        "region_ref",
        "demigod",
        "demigod_ref",
        "share"
      ],
      "type": "object"
    },
    "LonLat": {
      "description": "[longitude, latitude] in degrees (WGS84). Note the order: longitude first.",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "QueryEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/WorldEvent"
        },
        {
          "properties": {
            "beat": {
              "description": "The beat it happened.",
              "minimum": 0,
              "type": "integer"
            },
            "region_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Ref"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The region it happened in."
            }
          },
          "required": [
            "beat",
            "region_ref"
          ],
          "type": "object"
        }
      ],
      "description": "A public geotagged event (a world event plus its beat and region ref).",
      "type": "object"
    },
    "Ref": {
      "description": "A pointer to any row of the world: dg demigod, ch character, cl cluster, gr group, gd god, pl place, it item, ag agent, lg ledger row, ce cell, mb mob. Stable for the whole match.",
      "examples": [
        "ch:12"
      ],
      "pattern": "^(dg|ch|cl|gr|gd|pl|it|ag|lg|ce|mb):\\d+$",
      "type": "string"
    },
    "Stance": {
      "description": "What it is doing as a whole.",
      "enum": [
        "calm",
        "restless",
        "rioting",
        "fleeing",
        "worshipping",
        "fighting",
        "marching",
        "holding",
        "besieging",
        "raiding",
        "retreating",
        "rogue"
      ],
      "type": "string"
    },
    "Visual": {
      "description": "A character's visual sheet (docs/SHARED_MEDIA_SPEC.md §3.1): picked from the match seed, the character's id and name; the same at every beat and in every replay. Every image of the character carries these traits.",
      "properties": {
        "sheet_hash": {
          "description": "sha256 (hex) of the sheet version, the character's ref and its traits: key art or caches on it.",
          "type": "string"
        },
        "traits": {
          "description": "",
          "properties": {
            "build": {
              "description": "Body type.",
              "type": "string"
            },
            "colors": {
              "description": "Two signature colors (color words).",
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "emblem": {
              "description": "Their emblem (also on their armies' banners).",
              "type": "string"
            },
            "face": {
              "description": "Face and hair.",
              "type": "string"
            },
            "outfit": {
              "description": "What they wear.",
              "type": "string"
            },
            "prop": {
              "description": "The one thing they carry.",
              "type": "string"
            }
          },
          "required": [
            "build",
            "face",
            "outfit",
            "colors",
            "prop",
            "emblem"
          ],
          "type": "object"
        }
      },
      "required": [
        "sheet_hash",
        "traits"
      ],
      "type": "object"
    },
    "WorldEvent": {
      "description": "A public, geotagged world event (one ledger row): casts and their ramifications, armies raised, marching and fighting, freak weather, world mods, wounded gods, eliminations.",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LonLat"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where, [lon, lat]."
        },
        "image": {
          "$ref": "#/$defs/ImageObject",
          "description": "A moment card: only on events the media style's event_selection picks (and only with images on)."
        },
        "image_kind": {
          "description": "With image_prompt.",
          "enum": [
            "event"
          ],
          "type": "string"
        },
        "image_prompt": {
          "description": "Every public event: its image subject (a candidate moment card; it names who is in it with their visual sheets). Older recordings: only the big ones.",
          "type": "string"
        },
        "kind": {
          "description": "The row's verb: cast, happen, march, raise_army, shrink, damage, mood_shift, mod, unmod, wound, eliminate...",
          "type": "string"
        },
        "magnitude": {
          "description": "0..10.",
          "minimum": 0,
          "type": "integer"
        },
        "refs": {
          "description": "The actor, then the targets.",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "type": "array"
        },
        "region": {
          "description": "Region (planet) or district (city).",
          "type": [
            "string",
            "null"
          ]
        },
        "row": {
          "$ref": "#/$defs/Ref"
        },
        "text": {
          "description": "What happened, in prose.",
          "type": "string"
        }
      },
      "required": [
        "row",
        "kind",
        "text",
        "at",
        "region",
        "refs",
        "magnitude"
      ],
      "type": "object"
    },
    "WorldMod": {
      "description": "A persistent world mod (left by a cast's ramifications), applied every beat inside its radius.",
      "properties": {
        "at": {
          "$ref": "#/$defs/LonLat"
        },
        "by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "The caster."
        },
        "description": {
          "description": "",
          "type": "string"
        },
        "expires_beat": {
          "description": "null = lasting.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "",
          "type": "string"
        },
        "power": {
          "description": "The power that left it.",
          "type": [
            "string",
            "null"
          ]
        },
        "radius_km": {
          "description": "",
          "type": "number"
        },
        "region": {
          "description": "",
          "type": "string"
        },
        "region_ref": {
          "$ref": "#/$defs/Ref"
        },
        "since_beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "stacks": {
          "description": "1..5: the same mod again in the same region stacks.",
          "minimum": 0,
          "type": "integer"
        },
        "tags": {
          "description": "",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "at",
        "radius_km",
        "region",
        "region_ref",
        "tags",
        "stacks",
        "since_beat",
        "expires_beat",
        "power",
        "by"
      ],
      "type": "object"
    }
  },
  "$id": "query_globe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.globe`: the globe poll.",
  "properties": {
    "alive": {
      "description": "Demigods standing.",
      "minimum": 0,
      "type": "integer"
    },
    "arena": {
      "$ref": "#/$defs/Arena"
    },
    "armies": {
      "description": "Live armies.",
      "items": {
        "$ref": "#/$defs/ArmyMarker"
      },
      "type": "array"
    },
    "beat": {
      "description": "Last beat started.",
      "minimum": 0,
      "type": "integer"
    },
    "beats_total": {
      "description": "The Final Night's beat.",
      "minimum": 0,
      "type": "integer"
    },
    "demigods": {
      "description": "Every demigod, as in the PublicView.",
      "items": {
        "description": "A demigod as everyone sees it. Positions of live demigods are public; health is not.",
        "oneOf": [
          {
            "properties": {
              "alive": {
                "const": true
              }
            },
            "required": [
              "pos",
              "place"
            ]
          },
          {
            "properties": {
              "alive": {
                "const": false
              }
            },
            "required": [
              "eliminated_beat",
              "cause"
            ]
          }
        ],
        "properties": {
          "alive": {
            "type": "boolean"
          },
          "bolts": {
            "description": "Lightning bolts it holds (public).",
            "minimum": 0,
            "type": "integer"
          },
          "cause": {
            "description": "Eliminated only: how it fell.",
            "type": [
              "string",
              "null"
            ]
          },
          "connected": {
            "description": "true for an AI-controlled demigod (always there); null for a human one: the game never sees presence, so read room.updated seats[seat].connected.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "controller": {
            "description": "human: a Theatre seat whose player is human plays it (as the game knows: from match start and mid-match takeovers); ai: a Theatre bot seat or the built-in AI. Flips to human when a joiner takes it over. A human who leaves mid-match stays human here until someone takes the seat over: room.updated seats[].is_bot is the live truth.",
            "enum": [
              "human",
              "ai"
            ],
            "type": "string"
          },
          "diorama_image": {
            "$ref": "#/$defs/ImageObject",
            "description": "Its diorama, the table minifig (images on only; kind diorama)."
          },
          "diorama_image_kind": {
            "description": "The kind of diorama_prompt.",
            "enum": [
              "diorama"
            ],
            "type": "string"
          },
          "diorama_prompt": {
            "description": "An image prompt for its diorama: the demigod as a collectible minifig on a small base themed on its home region (where it started) with its signature prop (subject only, from its visual sheet; stable all match).",
            "type": "string"
          },
          "eliminated_beat": {
            "description": "Eliminated only.",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "image_kind": {
            "description": "The kind of portrait_prompt.",
            "enum": [
              "portrait"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "place": {
            "description": "Alive only: the place name it is in.",
            "type": "string"
          },
          "portrait_image": {
            "$ref": "#/$defs/ImageObject",
            "description": "Its portrait (images on only)."
          },
          "portrait_prompt": {
            "description": "An image prompt for its portrait (subject only, with its visual sheet; stable all match).",
            "type": "string"
          },
          "pos": {
            "$ref": "#/$defs/LonLat",
            "description": "Alive only."
          },
          "ref": {
            "$ref": "#/$defs/Ref"
          },
          "region": {
            "description": "Alive only: the region (planet) or district (city) it is in.",
            "type": "string"
          },
          "seat": {
            "description": "The Theatre seat; null for the built-in AI's demigods. A mid-match joiner's new seat takes over a built-in AI demigod, whose seat becomes that seat.",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "visual": {
            "$ref": "#/$defs/Visual",
            "description": "Its visual sheet (stable all match). Always present since the media release; absent in older recordings."
          }
        },
        "required": [
          "ref",
          "name",
          "alive",
          "seat"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "entropy": {
      "$ref": "#/$defs/Entropy"
    },
    "events": {
      "$ref": "#/$defs/EventPage"
    },
    "final_night": {
      "description": "",
      "type": "boolean"
    },
    "influence": {
      "description": "Each demigod's share of each region.",
      "items": {
        "$ref": "#/$defs/Influence"
      },
      "type": "array"
    },
    "mods": {
      "description": "Live world mods.",
      "items": {
        "$ref": "#/$defs/WorldMod"
      },
      "type": "array"
    }
  },
  "required": [
    "beat",
    "beats_total",
    "final_night",
    "arena",
    "alive",
    "entropy",
    "demigods",
    "influence",
    "mods",
    "armies",
    "events"
  ],
  "title": "game.globe",
  "type": "object",
  "x-applies-to": "game.globe reply (WebSocket), GET /api/rooms/{code}/query/globe",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {
      "limit": {
        "description": "Page size (default 30, at most 200).",
        "maximum": 200,
        "minimum": 1,
        "type": [
          "integer",
          "string"
        ]
      },
      "since": {
        "description": "Event cursor: a ledger row index (`next` from the previous page). Events from this row on. Omit for the latest events.",
        "minimum": 0,
        "type": [
          "integer",
          "string"
        ]
      }
    },
    "required": [],
    "type": "object"
  },
  "x-description": "The globe poll: arena circle, demigods' public positions, influence per region, live world mods, armies, Entropy, beat, and a page of recent public geotagged events.",
  "x-public": true
}
