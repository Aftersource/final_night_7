  "title": "game.faults_overview",
  "type": "object",
  "x-applies-to": "game.faults_overview reply (WebSocket), GET /api/rooms/{code}/query/faults_overview",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {},
    "required": [],
    "type": "object"
  },
  "x-description": "State schema 16, for the globe overlay while a mega is armed: every plate-boundary junction (`{lon, lat, name?, kind: triple|knot, strength 0..1, plates}`, strongest first), the tier thresholds and the curve's settings. The same for the whole match: ask once.",
  "x-public": true
}
