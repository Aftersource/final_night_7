{
  "$defs": {
    "Ref": {
      "description": "A pointer to any row of the world: dg demigod, ch character, cl cluster, gr group, gd god, pl place, it item, ag agent, lg ledger row, ce cell, mb mob. Stable for the whole match.",
      "examples": [
        "ch:12"
      ],
      "pattern": "^(dg|ch|cl|gr|gd|pl|it|ag|lg|ce|mb):\\d+$",
      "type": "string"
    }
  },
  "$id": "query_powers.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.powers`.",
  "properties": {
    "powers": {
      "description": "The palette, then the custom entry.",
      "items": {
        "description": "One power of the palette (data/powers.json), or the custom entry.",
        "properties": {
          "blurb": {
            "description": "Rules 0.8.0: what it does.",
            "type": "string"
          },
          "cost": {
            "description": "Bolts; null for custom (priced by magnitude).",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "damage": {
            "description": "Direct damage to a body it hits.",
            "type": [
              "number",
              "null"
            ]
          },
          "god": {
            "description": "Rules 0.8.0: the god's slug.",
            "type": "string"
          },
          "god_ref": {
            "anyOf": [
              {
                "$ref": "#/$defs/Ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "icon": {
            "description": "Icon key (= slug).",
            "type": "string"
          },
          "magnitude": {
            "maximum": 10,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "mega": {
            "description": "Rules 0.7.0: the MEGA variant (map scale; send `cast.tier: \"mega\"`).",
            "properties": {
              "cost": {
                "description": "1 bolt.",
                "minimum": 0,
                "type": "integer"
              },
              "damage": {
                "description": "Its target's damage; rival demigods within the radius take 40%.",
                "type": "number"
              },
              "magnitude": {
                "description": "",
                "minimum": 0,
                "type": "integer"
              },
              "radius_km": {
                "description": "",
                "type": "number"
              }
            },
            "required": [
              "radius_km",
              "magnitude",
              "damage",
              "cost"
            ],
            "type": "object"
          },
          "mini": {
            "description": "Rules 0.7.0: the MINI variant (the board; `cast.tier: \"mini\"`, the default).",
            "properties": {
              "cost": {
                "description": "1 spark.",
                "minimum": 0,
                "type": "integer"
              },
              "damage": {
                "description": "",
                "type": "number"
              },
              "magnitude": {
                "description": "",
                "minimum": 0,
                "type": "integer"
              },
              "radius_km": {
                "description": "",
                "type": "number"
              }
            },
            "required": [
              "radius_km",
              "magnitude",
              "damage",
              "cost"
            ],
            "type": "object"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "radius_km": {
            "description": "Area it affects.",
            "type": "number"
          },
          "slug": {
            "description": "Its id (send as `cast.power`).",
            "type": "string"
          },
          "tags": {
            "description": "",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "target": {
            "description": "What it is aimed at.",
            "enum": [
              "point",
              "region",
              "unit"
            ],
            "type": "string"
          },
          "tier": {
            "const": "god",
            "description": "Rules 0.8.0: a god-tier power (cast with `tier: \"god\"`; `cost` in bolts)."
          }
        },
        "required": [
          "slug",
          "name",
          "icon",
          "cost",
          "radius_km",
          "target",
          "magnitude",
          "damage",
          "tags"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "powers"
  ],
  "title": "game.powers",
  "type": "object",
  "x-applies-to": "game.powers reply (WebSocket), GET /api/rooms/{code}/query/powers",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {},
    "required": [],
    "type": "object"
  },
  "x-description": "The power palette (casts), then the custom entry.",
  "x-public": true
}
