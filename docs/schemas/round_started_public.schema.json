            },
            "player": {
              "description": "",
              "type": "string"
            },
            "portrait_image": {
              "type": "object"
            },
            "portrait_prompt": {
              "description": "",
              "type": "string"
            },
            "seat": {
              "description": "null for the built-in AI.",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "demigod",
            "name",
            "player",
            "seat",
            "controller",
            "health",
            "max_health",
            "portrait_prompt",
            "diorama_prompt"
          ],
          "type": "object"
        },
        "beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "by_seat": {
          "description": "The challenger's seat; null for the AI.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cell": {
          "description": "The hex at `level`.",
          "type": "string"
        },
        "distance_km": {
          "description": "",
          "type": "number"
        },
        "duel_id": {
          "description": "duel:<beat>:<a>:<b>",
          "type": "string"
        },
        "ends": {
          "enum": [
            "resolve",
            "ko_or_deadline"
          ],
          "type": "string"
        },
        "event": {
          "const": "challenge.lock"
        },
        "focus": {
          "description": "Centre the camera and spin the globe here.",
          "properties": {
            "at": {
              "$ref": "#/$defs/LonLat"
            },
            "cell": {
              "description": "",
