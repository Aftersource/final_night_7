            }
          },
          "required": [
            "requested",
            "supported",
            "participants",
            "deadline_ms"
          ],
          "type": "object"
        },
        "leap": {
          "description": "The AI challenger summoned itself next to its rival first (applied at the resolve).",
          "properties": {
            "demigod": {
              "$ref": "#/$defs/Ref"
            },
            "health_lost": {
              "description": "",
              "type": "number"
            },
            "to": {
              "$ref": "#/$defs/LonLat"
