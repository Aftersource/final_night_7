{
  "$defs": {
    "EarthCells": {
      "description": "State schema 13: cell columns (docs/EARTH_SIM.md §7). `enc: pack` (the default): `data` is one base64 block, per cell in index order: varint index delta, height byte (0..15), top byte (an index into `tops`), varint layer mask, then one byte per set layer (CLIENT_LAYERS order; `heat` signed). `enc: columns`: `cells` (u16 LE), `h`, `top` and `layers{name}`, one base64 array each. `enc: json`: the same columns as number arrays.",
      "properties": {
        "cells": {
          "description": "Regions-grid cell indices.",
          "type": [
            "string",
            "array"
          ]
        },
        "data": {
          "description": "enc pack: the base64 block.",
          "type": "string"
        },
        "enc": {
          "description": "",
          "enum": [
            "pack",
            "columns",
            "json"
          ],
          "type": "string"
        },
        "h": {
          "description": "Heights 0..15 (8 = sea level).",
          "type": [
            "string",
            "array"
          ]
        },
        "layers": {
          "additionalProperties": {
            "type": [
              "string",
              "array"
            ]
          },
          "description": "A column per non-zero layer.",
          "type": "object"
        },
        "n": {
          "description": "Cells.",
          "minimum": 0,
          "type": "integer"
        },
        "top": {
          "description": "Top material indices (into `tops`).",
          "type": [
            "string",
            "array"
          ]
        }
      },
      "required": [
        "n",
        "enc"
      ],
      "type": "object"
    },
    "EarthEffect": {
      "description": "State schema 20: one thing the earth did (docs/EARTH_SIM.md §13). `cell` is at the thing's level: houses for buildings, people for demigods, persons and shrines, villages for settlements and crowds, regions for forests, roads and armies.",
      "properties": {
        "amount": {
          "description": "Damage (demigod, person); share of vegetation gone as the front crossed (forest); ruin share (building); levels lost / 3 (settlement).",
          "type": "number"
        },
        "cause": {
          "description": "The phenomenon's id (0: none named).",
          "minimum": 0,
          "type": "integer"
        },
        "cell": {
          "description": "Hex key `face:level:q:r`.",
          "type": "string"
        },
        "count": {
          "description": "People.",
          "minimum": 0,
          "type": "integer"
        },
        "level": {
          "description": "",
          "enum": [
            "regions",
            "villages",
            "houses",
            "people"
          ],
          "type": "string"
        },
        "phenomenon": {
          "description": "The cause's kind.",
          "enum": [
            "storm",
            "lightning",
            "flood",
            "wildfire",
            "volcano",
            "earthquake",
            "meteor",
            "raise_land",
            "sink_land",
            "forest",
            "swarm",
            "blizzard",
            "tidal_wave",
            "plate_drift"
          ],
          "type": "string"
        },
        "power": {
          "description": "The cast's magnitude, 1..10.",
          "minimum": 0,
          "type": "integer"
        },
        "seat": {
          "description": "The caster's seat.",
          "minimum": 0,
          "type": "integer"
        },
        "thing": {
          "description": "",
          "properties": {
            "kind": {
              "description": "",
              "enum": [
                "building",
                "forest",
                "crowd",
                "road",
                "shrine",
                "demigod",
                "person",
                "army",
                "settlement"
              ],
              "type": "string"
            },
            "ref": {
              "description": "cl:N (crowd, army), dg:N, ch:N (person), pl:N (settlement; a building's settlement), shrine:ID, pl:A~pl:B (road).",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "to_cell": {
          "description": "Where they went (fled: the shelter; returned: home).",
          "type": "string"
        },
        "what": {
          "description": "",
          "enum": [
            "burned",
            "flooded",
            "destroyed",
            "damaged",
            "fled",
            "died",
            "sheltered",
            "buried",
            "swept",
            "returned"
          ],
          "type": "string"
        }
      },
      "required": [
        "cell",
        "level",
        "thing",
        "what",
        "cause"
      ],
      "type": "object"
    },
    "EarthPhenomenon": {
      "description": "State schema 13: one live phenomenon of the Earth simulator.",
      "properties": {
        "age": {
          "description": "Beats since it began.",
          "minimum": 0,
          "type": "integer"
        },
        "at": {
          "$ref": "#/$defs/LonLat"
        },
        "beats_left": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "born": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "cause": {
          "description": "",
          "enum": [
            "cast",
            "god",
            "ramification",
            "entropy",
            "interaction"
          ],
          "type": "string"
        },
        "cell": {
          "description": "Regions-level hex key.",
          "type": "string"
        },
        "cell_index": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "front_cells": {
          "type": "integer"
        },
        "front_km": {
          "type": "integer"
        },
        "front_speed_cells_per_beat": {
          "type": "integer"
        },
        "id": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "intensity": {
          "description": "power / 16 (a mega of magnitude 8 starts near 8).",
          "type": "number"
        },
        "kind": {
          "description": "",
          "enum": [
            "storm",
            "lightning",
            "flood",
            "wildfire",
            "volcano",
            "earthquake",
            "meteor",
            "raise_land",
            "sink_land",
            "forest",
            "swarm",
            "blizzard",
            "tidal_wave",
            "plate_drift"
          ],
          "type": "string"
        },
        "moves_left": {
          "type": "integer"
        },
        "next_move_in": {
          "type": "integer"
        },
        "origin": {
          "$ref": "#/$defs/LonLat"
        },
        "owner_seat": {
          "description": "The seat that cast it; null = the world's own.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parent": {
          "description": "The phenomenon that set it off.",
          "minimum": 0,
          "type": "integer"
        },
        "power": {
          "type": "integer"
        },
        "radius_cells": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "radius_km": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "ruptured_cells": {
          "type": "integer"
        },
        "state": {
          "description": "A volcano's.",
          "enum": [
            "erupting",
            "dormant"
          ],
          "type": "string"
        },
        "tier": {
          "description": "",
          "enum": [
            "mini",
            "mega",
            "god",
            "world"
          ],
          "type": "string"
        },
        "velocity": {
          "description": "Where it will be a beat from now (glide toward it).",
          "properties": {
            "cells_per_beat": {
              "description": "",
              "type": "number"
            },
            "dir": {
              "description": "Hex direction 0..5.",
              "minimum": 0,
              "type": "integer"
            },
            "to": {
              "$ref": "#/$defs/LonLat"
            },
            "to_cell": {
              "description": "",
              "type": "string"
            }
          },
          "required": [
            "dir",
            "to",
            "to_cell",
            "cells_per_beat"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "at",
        "cell",
        "cell_index",
        "origin",
        "radius_cells",
        "radius_km",
        "power",
        "intensity",
        "age",
        "born",
        "beats_left",
        "owner_seat",
        "cause",
        "tier"
      ],
      "type": "object"
    },
    "EarthScars": {
      "description": "State schema 20: what the earth left, per cell, at a beat (docs/EARTH_SIM.md §13): draw lasting damage at any zoom.",
      "properties": {
        "beat": {
          "description": "",
          "minimum": 0,
          "type": "integer"
        },
        "burnt": {
          "description": "Land burned off, regrowing.",
          "items": {
            "description": "",
            "properties": {
              "base": {
                "description": "Vegetation at rest.",
                "minimum": 0,
                "type": "integer"
              },
              "cell": {
                "description": "",
                "type": "string"
              },
              "fuel": {
                "description": "Vegetation now.",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "cell",
              "fuel",
              "base"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "fallen": {
          "description": "The dead of the last 12 beats, per cell.",
          "items": {
            "description": "",
            "properties": {
              "beat": {
                "description": "The latest beat.",
                "minimum": 0,
                "type": "integer"
              },
              "cell": {
                "description": "",
                "type": "string"
              },
              "count": {
                "description": "",
                "minimum": 0,
                "type": "integer"
              },
              "level": {
                "description": "",
                "enum": [
                  "regions",
                  "villages",
                  "houses",
                  "people"
                ],
                "type": "string"
              }
            },
            "required": [
              "cell",
              "level",
              "count",
              "beat"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "mud": {
          "description": "A flood drying.",
          "items": {
            "description": "",
            "properties": {
              "cell": {
                "description": "",
                "type": "string"
              },
              "water": {
                "description": "1..23 left.",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "cell",
              "water"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "ruins": {
          "description": "Ruin ≥ 96.",
          "items": {
            "description": "",
            "properties": {
              "cell": {
                "description": "",
                "type": "string"
              },
              "ruin": {
                "description": "",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "cell",
              "ruin"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "sheltering": {
          "description": "People in shelters then.",
          "items": {
            "description": "",
            "properties": {
              "at": {
                "description": "Houses-level shelter.",
                "type": "string"
              },
              "cause": {
                "description": "",
                "minimum": 0,
                "type": "integer"
              },
              "count": {
                "description": "",
                "minimum": 0,
                "type": "integer"
              },
              "crowd": {
                "description": "",
                "type": "string"
              },
              "from": {
                "description": "Villages-level home.",
                "type": "string"
              },
              "settlement": {
                "description": "",
                "type": "string"
              },
              "since": {
                "description": "",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "crowd",
              "from",
              "at",
              "settlement",
              "count",
              "since",
              "cause"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "wrecks": {
          "description": "Buildings destroyed.",
          "items": {
            "description": "",
            "properties": {
              "beat": {
                "description": "",
                "minimum": 0,
                "type": "integer"
              },
              "cause": {
                "description": "",
                "minimum": 0,
                "type": "integer"
              },
              "cell": {
                "description": "Houses-level hex.",
                "type": "string"
              },
              "how": {
                "description": "",
                "enum": [
                  "destroyed",
                  "burned",
                  "buried",
                  "swept"
                ],
                "type": "string"
              },
              "settlement": {
                "description": "",
                "type": "string"
              }
            },
            "required": [
              "cell",
              "settlement",
              "beat",
              "how",
              "cause"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "beat",
        "burnt",
        "mud",
        "ruins",
        "wrecks",
        "sheltering",
        "fallen"
      ],
      "type": "object"
    },
    "LonLat": {
      "description": "[longitude, latitude] in degrees (WGS84). Note the order: longitude first.",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  },
  "$id": "query_earth_at.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`game.earth_at` (state schema 13): the whole field at the end of a past beat, rebuilt from a keyframe.",
  "properties": {
    "beat": {
      "description": "The beat shown.",
      "minimum": 0,
      "type": "integer"
    },
    "dirty": {
      "description": "",
      "minimum": 0,
      "type": "integer"
    },
    "effects": {
      "description": "State schema 20: what the earth did this beat, thing by thing, worst first, at most `earth_effects_max` (docs/EARTH_SIM.md §13).",
      "items": {
        "$ref": "#/$defs/EarthEffect"
      },
      "type": "array"
    },
    "effects_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "State schema 20: effects per `what`, before the cap.",
      "type": "object"
    },
    "effects_total": {
      "description": "State schema 20: effects before the cap.",
      "minimum": 0,
      "type": "integer"
    },
    "field": {
      "$ref": "#/$defs/EarthCells"
    },
    "from_keyframe": {
      "description": "",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "hash": {
      "description": "",
      "type": "string"
    },
    "inputs": {
      "description": "Inputs up to that beat.",
      "minimum": 0,
      "type": "integer"
    },
    "keyframes": {
      "description": "",
      "items": {
        "type": "integer"
      },
      "type": "array"
    },
    "layers": {
      "description": "CLIENT_LAYERS: layer names by bit (absent in a board or tiles answer).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "now": {
      "description": "The last beat stepped.",
      "minimum": 0,
      "type": "integer"
    },
    "phenomena": {
      "description": "",
      "items": {
        "$ref": "#/$defs/EarthPhenomenon"
      },
      "type": "array"
    },
    "rebuilt": {
      "description": "Re-simulated from a keyframe (a past beat).",
      "type": "boolean"
    },
    "resimulated_beats": {
      "description": "",
      "minimum": 0,
      "type": "integer"
    },
    "scars": {
      "$ref": "#/$defs/EarthScars"
    },
    "tops": {
      "description": "Top material names by index.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "beat",
    "now",
    "hash",
    "dirty",
    "phenomena",
    "rebuilt",
    "from_keyframe",
    "resimulated_beats",
    "tops",
    "layers",
    "field",
    "keyframes",
    "inputs"
  ],
  "title": "game.earth_at",
  "type": "object",
  "x-applies-to": "game.earth_at reply (WebSocket), GET /api/rooms/{code}/query/earth_at",
  "x-args": {
    "additionalProperties": true,
    "description": "Over HTTP every arg is a query-string parameter (numbers as numeric strings). Unknown args are ignored.",
    "properties": {
      "beat": {
        "description": "The beat.",
        "minimum": 0,
        "type": [
          "integer",
          "string"
        ]
      },
      "format": {
        "description": "Cell encoding (default pack).",
        "enum": [
          "pack",
          "columns",
          "json"
        ],
        "type": "string"
      }
    },
    "required": [
      "beat"
    ],
    "type": "object"
  },
  "x-description": "The Earth simulator, time travel: the whole field (every cell that differs from base, and the phenomena) as it stood at the end of a past beat, rebuilt from the newest keyframe at or before it by re-simulating at most `earth_keyframe_beats` beats of the recorded inputs.",
  "x-public": true
}
