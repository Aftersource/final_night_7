 set -a; . __production_steps/meshy.env; set +a
 F="--output-schema v1 --format json --no-update-check"
 T=$(meshy image-to-3d create --image-url "$IMG" --model-type standard --should-texture true --enable-pbr true --texture-resolution 2k --target-formats glb,fbx --async $F 2>/dev/null | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['result']['submission']['task_id'] if d['ok'] else 'ERR '+json.dumps(d['error']))")
@@ -32,4 +34,27 @@
                       "preview": f"{slug}/preview.png", "source_image": f"{slug}/heroic.png", "meshy_task": task, "result": res}
 json.dump(d, open(idx, "w"), indent=1, sort_keys=True)
 EOF
+# One job record per provider job (fn7 server docs/ASSETS.md, "Job records"). `fn7-assets import-jobs $W/jobs.jsonl`
+# puts it in the server's asset registry: parameters, task id, credits, measured times, file hashes, lineage.
+python3 - "$W/jobs.jsonl" "$P/task_$T.json" "$KIND" "$SLUG" "$NAME" "$T" <<'EOF'
+import json, os, sys, time
+out, task_json, kind, slug, name, task = sys.argv[1:7]
+t = json.load(open(task_json)) if os.path.exists(task_json) else {}
+base = f"figures/{slug}"
+rec = {"v": 1, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "provider": "meshy", "operation": "image-to-3d",
+       "endpoint": "/openapi/v1/image-to-3d", "task_id": task, "status": t.get("status", "UNKNOWN"),
+       "credits": t.get("consumed_credits"), "requested_at": t.get("created_at"), "started_at": t.get("started_at"),
+       "finished_at": t.get("finished_at"), "error": (t.get("task_error") or {}).get("message") or None,
+       "params": {"model_type": "standard", "should_texture": True, "enable_pbr": True, "texture_resolution": "2k",
+                  "target_formats": "glb,fbx"},
+       "subject": {"kind": kind, "name": name, "slug": slug},
+       "asset": {"kind": "model", "subkind": "statue", "variant": ""},
+       "inputs": [{"path": f"{base}/heroic.png", "role": "source", "variant": "heroic"}],
+       "outputs": [{"path": f"{base}/{slug}_statue.glb", "role": "primary"},
+                   {"path": f"{base}/preview.png", "role": "preview", "optional": True},
+                   {"path": f"{base}/{slug}_statue.fbx", "role": "fbx", "optional": True}],
+       "requested_by": "operator", "tool": "tools/meshy/make_statue.sh"}
+with open(out, "a") as f:
+    f.write(json.dumps(rec, sort_keys=True) + "\n")
+EOF
 meshy balance $F 2>/dev/null | python3 -c "import sys,json; print('balance', json.load(sys.stdin)['result']['balance'])"
--- a/tools/meshy/make_figure.sh
+++ b/tools/meshy/make_figure.sh
@@ -2,7 +2,7 @@
 # Make a rigged 3D figure of a demigod from a full-body A-pose image, on the SAME skeleton as the duel mannequin
 # (Meshy's ue5_mannequin template), so the mannequin's 35 clips play on it with no extra animation credits.
 #
-#   tools/meshy/make_figure.sh <slug> <apose.png>
+#   tools/meshy/make_figure.sh <slug> <apose.png> ["<display name>"]
 #
 # COSTS MESHY CREDITS: about 30 for the textured model + 5 for the rig (docs/MESHY.md). Run it only with Chris's or
 # Benito's explicit go, and log the job in __production_steps/MESHY.md.
@@ -10,9 +10,30 @@
 # Run from the repo root. The A-pose image: the whole body, arms away from the body, a plain background, no base,
 # no props (see production_assets/meshy/figures/chris_left_hand/apose.png for one made from a game portrait).
 set -e
-SLUG=$1; IMG=$2; [ -f "$IMG" ] || { echo "usage: $0 <slug> <apose.png>"; exit 1; }
+SLUG=$1; IMG=$2; NAME=${3:-$SLUG}; [ -f "$IMG" ] || { echo "usage: $0 <slug> <apose.png> [\"<display name>\"]"; exit 1; }
 set -a; . __production_steps/meshy.env; set +a
 W=production_assets/meshy; OUT=$W/figures/$SLUG; mkdir -p "$OUT"
+# The job records below name the source image by its place in the figure's folder: keep a copy there.
+[ "$IMG" -ef "$OUT/apose.png" ] || cp "$IMG" "$OUT/apose.png"
+# One job record per provider job (fn7 server docs/ASSETS.md, "Job records"). `fn7-assets import-jobs $W/jobs.jsonl`
+# puts it in the server's asset registry: parameters, task id, credits, measured times, file hashes, lineage.
+job(){ # <task id> <operation> <endpoint> <variant> <params json> <inputs json> <outputs json> <lineage json>
+python3 - "$W/jobs.jsonl" "$P/task_$1.json" "$SLUG" "$NAME" "$@" <<'EOF'
+import json, os, sys, time
+out, task_json, slug, name, task, op, endpoint, variant, params, inputs, outputs, lineage = sys.argv[1:13]
+t = json.load(open(task_json)) if os.path.exists(task_json) else {}
+rec = {"v": 1, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "provider": "meshy", "operation": op,
+       "endpoint": endpoint, "task_id": task, "status": t.get("status", "UNKNOWN"), "credits": t.get("consumed_credits"),
+       "requested_at": t.get("created_at"), "started_at": t.get("started_at"), "finished_at": t.get("finished_at"),
+       "error": (t.get("task_error") or {}).get("message") or None, "params": json.loads(params),
+       "subject": {"kind": "demigod", "name": name, "slug": slug},
+       "asset": {"kind": "model", "subkind": "figure", "variant": variant},
+       "inputs": json.loads(inputs), "outputs": json.loads(outputs), "lineage": json.loads(lineage),
+       "requested_by": "operator", "tool": "tools/meshy/make_figure.sh"}
+with open(out, "a") as f:
+    f.write(json.dumps(rec, sort_keys=True) + "\n")
+EOF
+}
 F="--output-schema v1 --format json --no-update-check"
 id(){ python3 -c "import sys,json; d=json.load(sys.stdin); print(d['result']['submission']['task_id'] if d['ok'] else 'ERR '+json.dumps(d['error']))"; }
 st(){ python3 -c "import sys,json; d=json.load(sys.stdin); t=d['result'].get('task',{}); print(d['ok'], t.get('status'), 'credits', t.get('consumed_credits'), json.dumps(d.get('error'))[:200])"; }
@@ -22,10 +43,17 @@
 P=$(meshy project init --root "$W" --name "figure_$SLUG" --task-id $T --task-type image-to-3d --workspace "$W" $F 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['result']['project_dir'])")
 meshy image-to-3d wait $T --timeout 900 --project "$P" --stage model --workspace "$W" $F 2>/dev/null | st
 meshy download --task-json "$P/task_$T.json" --asset thumbnail.primary --output "$OUT/preview.png" --workspace "$W" $F >/dev/null 2>&1 || true
+job "$T" image-to-3d /openapi/v1/image-to-3d mesh \
+  '{"model_type":"standard","pose_mode":"a-pose","should_texture":true,"enable_pbr":true,"texture_resolution":"2k","target_formats":"glb,fbx"}' \
+  "[{\"path\":\"figures/$SLUG/apose.png\",\"role\":\"source\",\"variant\":\"apose\"}]" \
+  "[{\"path\":\"figures/$SLUG/preview.png\",\"role\":\"preview\",\"optional\":true}]" '[]'
 
 R=$(meshy rigging create --input-task-id $T --height-meters 1.7 --data '{"skeleton_template":"ue5_mannequin"}' --async --project "$P" --stage rigging --workspace "$W" $F 2>/dev/null | id)
 echo "rig task $R"; echo "$(date -u +%FT%TZ) figure $SLUG rigging $R" >> __production_steps/meshy_jobs.log
 meshy rigging wait $R --timeout 900 --project "$P" --stage rigging --workspace "$W" $F 2>/dev/null | st
 meshy download --task-json "$P/task_$R.json" --asset result.rigged_character_glb_url --output "$OUT/${SLUG}_rigged.glb" --workspace "$W" $F >/dev/null 2>&1 && echo "saved $OUT/${SLUG}_rigged.glb"
 meshy download --task-json "$P/task_$R.json" --asset result.rigged_character_fbx_url --output "$OUT/${SLUG}_rigged.fbx" --workspace "$W" $F >/dev/null 2>&1 && echo "saved $OUT/${SLUG}_rigged.fbx"
+job "$R" rigging /openapi/v1/rigging "" '{"height_meters":1.7,"skeleton_template":"ue5_mannequin"}' '[]' \
+  "[{\"path\":\"figures/$SLUG/${SLUG}_rigged.glb\",\"role\":\"primary\"},{\"path\":\"figures/$SLUG/${SLUG}_rigged.fbx\",\"role\":\"fbx\",\"optional\":true}]" \
+  "[{\"role\":\"rig_of\",\"parent_task_id\":\"$T\"}]"
 meshy balance $F 2>/dev/null | python3 -c "import sys,json; print('balance', json.load(sys.stdin)['result']['balance'])"
